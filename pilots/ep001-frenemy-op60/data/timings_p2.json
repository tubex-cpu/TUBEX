[
 {
  "id": "P1",
  "start": 0.6,
  "end": 4.658,
  "sub": "今日の動画では、フレネミーについて\n三つのことを明らかにします。"
 },
 {
  "id": "P2",
  "start": 5.2,
  "end": 10.841,
  "sub": "一つ目。フレネミーの正体。\nなぜ、一番近くにいる人ほどフレネミーになるのか。"
 },
 {
  "id": "P3",
  "start": 11.2,
  "end": 13.985,
  "sub": "脳の実験と心理学の理論で解き明かします。"
 },
 {
  "id": "P4",
  "start": 14.6,
  "end": 19.247,
  "sub": "二つ目。フレネミーが横にいるだけで、\nあなたの体に起きるヤバいこと。"
 },
 {
  "id": "P5",
  "start": 19.9,
  "end": 22.503,
  "sub": "三つ目。これが当てはまるならフレネミー。"
 },
 {
  "id": "P6",
  "start": 22.95,
  "end": 27.606,
  "sub": "研究で裏付けられた「いい知らせテスト」で、\nあなたの周りの本当の味方と、"
 },
 {
  "id": "P7",
  "start": 27.9,
  "end": 29.434,
  "sub": "フレネミーを見分ける方法。"
 },
 {
  "id": "P8",
  "start": 30.3,
  "end": 35.19,
  "sub": "フレネミーは、いい報告をしたときの、\nたった一つの反応で見分けられます。"
 },
 {
  "id": "P9",
  "start": 35.6,
  "end": 38.548,
  "sub": "それが何かは、動画の後半でお見せします。"
 },
 {
  "id": "P10",
  "start": 39.3,
  "end": 42.281,
  "sub": "あなたが次に、誰かにいい報告をする前に。"
 },
 {
  "id": "P11",
  "start": 42.6,
  "end": 45.486,
  "sub": "この見分け方を、必ず知っておいてください。"
 },
 {
  "id": "Q1",
  "start": 47.0,
  "end": 52.231,
  "sub": "フレネミーの正体に迫る前に、\nあなた自身の心で、一つ実験をしてみます。"
 },
 {
  "id": "Q2",
  "start": 52.7,
  "end": 56.046,
  "sub": "道具はいりません。\nこれから三つの場面を読み上げます。"
 },
 {
  "id": "Q3",
  "start": 56.5,
  "end": 63.845,
  "sub": "それぞれの場面で、自分の胸がどれくらいざわっとするかを、\n心の中で0から10の点数で採点してください。"
 },
 {
  "id": "Q4",
  "start": 64.8,
  "end": 65.319,
  "sub": "一つ目。"
 },
 {
  "id": "Q5",
  "start": 65.6,
  "end": 70.731,
  "sub": "テレビの向こうの世界的な有名人が、\n何十億円という大成功をおさめた。"
 },
 {
  "id": "Q6",
  "start": 71.1,
  "end": 73.364,
  "sub": "胸のざわつきは、何点でしょうか。"
 },
 {
  "id": "Q7",
  "start": 75.7,
  "end": 76.23,
  "sub": "二つ目。"
 },
 {
  "id": "Q8",
  "start": 76.5,
  "end": 80.459,
  "sub": "あなたとはまったく違う仕事をしている友達が、\n昇進した。"
 },
 {
  "id": "Q9",
  "start": 80.8,
  "end": 81.8,
  "sub": "何点でしょうか。"
 },
 {
  "id": "Q10",
  "start": 84.1,
  "end": 84.643,
  "sub": "三つ目。"
 },
 {
  "id": "Q11",
  "start": 84.95,
  "end": 91.327,
  "sub": "あなたと同じ仕事をしていて、ずっと一緒にがんばってきた友達が、\nあなたより先に昇進した。"
 },
 {
  "id": "Q12",
  "start": 91.7,
  "end": 92.7,
  "sub": "何点でしょうか。"
 },
 {
  "id": "Q13",
  "start": 95.2,
  "end": 97.308,
  "sub": "あなたの点数は、どうでしたか。"
 },
 {
  "id": "Q14",
  "start": 97.9,
  "end": 102.271,
  "sub": "そしてこの答えこそが、\nそのままフレネミーが生まれてしまう根源です。"
 },
 {
  "id": "Q15",
  "start": 102.9,
  "end": 105.697,
  "sub": "フレネミーにあなたの人生が邪魔されないために、"
 },
 {
  "id": "Q16",
  "start": 106.1,
  "end": 110.41,
  "sub": "あなた自身がフレネミーにならないためにも\nこの動画を最後まで見て下さい。"
 }
]