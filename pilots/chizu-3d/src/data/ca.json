"subs": [
{
"start": 0.0,
"end": 3.052,
"lines": [
"カナダの面積は　日本の約二十六倍"
]
},
{
"start": 3.652,
"end": 5.49,
"lines": [
"世界で二番目に広い国です"
]
},
{
"start": 6.09,
"end": 8.735,
"lines": [
"ところが今　このカナダで家が足りません"
]
},
{
"start": 9.335,
"end": 15.408,
"lines": [
"家の値段は　物価の上昇を差し引いても",
"二〇〇五年からの二十年で約二倍になりました"
]
},
{
"start": 16.008,
"end": 19.769,
"lines": [
"比べた十九の国の中で",
"いちばん大きな上がり方です"
]
},
{
"start": 20.369,
"end": 23.159,
"lines": [
"これだけ広い国で　なぜ家が足りないのか"
]
},
{
"start": 23.759,
"end": 26.272,
"lines": [
"今日はこの謎を　地図で解いていきます"
]
},
{
"start": 27.872,
"end": 29.597,
"lines": [
"よくある答えは二つあります"
]
},
{
"start": 30.197,
"end": 32.072,
"lines": [
"寒くて住める場所が少ないから"
]
},
{
"start": 32.672,
"end": 33.978,
"lines": [
"人が急に増えたから"
]
},
{
"start": 34.578,
"end": 36.147,
"lines": [
"どちらも話の一部です"
]
},
{
"start": 36.747,
"end": 39.17,
"lines": [
"ただ　それだけでは答えになりません"
]
},
{
"start": 39.77,
"end": 46.565,
"lines": [
"今日は　国　都市　そして家を建てる一つひと",
"つの土地へと　地図を三段階で拡大します"
]
},
{
"start": 47.165,
"end": 50.078,
"lines": [
"拡大するたびに　別の理由が見えてきます"
]
},
{
"start": 51.678,
"end": 53.353,
"lines": [
"まず　国全体です"
]
},
{
"start": 53.953,
"end": 58.12,
"lines": [
"カナダの面積は",
"約九百九十八万平方キロメートル"
]
},
{
"start": 58.72,
"end": 61.394,
"lines": [
"ロシアに次ぐ　世界第二位の広さです"
]
},
{
"start": 61.994,
"end": 66.667,
"lines": [
"二〇二一年の国勢調査の人口は　約三千七百万人"
]
},
{
"start": 67.267,
"end": 70.735,
"lines": [
"一平方キロメートルあたり　わずか四・二人です"
]
},
{
"start": 71.335,
"end": 74.642,
"lines": [
"日本の人口密度は　その約八十倍です"
]
},
{
"start": 76.242,
"end": 77.973,
"lines": [
"もう少し身近に比べます"
]
},
{
"start": 78.573,
"end": 85.804,
"lines": [
"カナダ全体の人口は　東京都と神奈川　埼玉",
"千葉を合わせた東京圏の人口とほぼ同じです"
]
},
{
"start": 86.404,
"end": 90.764,
"lines": [
"日本の二十六倍の国に",
"東京圏ぶんの人しか住んでいません"
]
},
{
"start": 91.364,
"end": 94.401,
"lines": [
"数字だけを見れば",
"土地はいくらでもありそうです"
]
},
{
"start": 96.001,
"end": 98.754,
"lines": [
"では　その広い土地はどうなっているのか"
]
},
{
"start": 99.354,
"end": 100.388,
"lines": [
"北へ目を向けます"
]
},
{
"start": 100.988,
"end": 107.446,
"lines": [
"ユーコン　ノースウエスト　ヌナブトの三つの",
"準州だけで　国の陸地の四割近くを占めます"
]
},
{
"start": 108.046,
"end": 112.494,
"lines": [
"ところが三つの準州の人口は",
"合わせて約十一万八千人"
]
},
{
"start": 113.094,
"end": 115.169,
"lines": [
"全国の〇・三パーセントです"
]
},
{
"start": 116.769,
"end": 119.753,
"lines": [
"北の大地の下には　永久凍土があります"
]
},
{
"start": 120.353,
"end": 124.625,
"lines": [
"カナダの陸地の約半分の下で",
"地面が一年中凍っています"
]
},
{
"start": 125.225,
"end": 129.18,
"lines": [
"凍った地面の上に家や道路を造るのは",
"簡単ではありません"
]
},
{
"start": 130.78,
"end": 135.663,
"lines": [
"さらに　国のほぼ半分は",
"カナダ盾状地と呼ばれる岩盤の大地です"
]
},
{
"start": 136.263,
"end": 138.905,
"lines": [
"面積は約五百万平方キロメートル"
]
},
{
"start": 139.505,
"end": 145.132,
"lines": [
"陸地の約四十八パーセントで",
"岩がむき出しになり　土が薄い土地が広がります"
]
},
{
"start": 146.732,
"end": 149.786,
"lines": [
"こうして見ると　畑にできる土地も限られます"
]
},
{
"start": 150.386,
"end": 153.84,
"lines": [
"カナダの農場の面積は　陸地の約七パーセント"
]
},
{
"start": 154.44,
"end": 159.527,
"lines": [
"中でもいちばん良い第一等級の農地は",
"国土の〇・五パーセントもありません"
]
},
{
"start": 160.127,
"end": 163.791,
"lines": [
"その半分以上が",
"オンタリオ州の南部に集まっています"
]
},
{
"start": 165.391,
"end": 168.388,
"lines": [
"その良い農地の上に　街が広がってきました"
]
},
{
"start": 168.988,
"end": 174.201,
"lines": [
"二〇〇一年の時点で　カナダの第一等級の",
"農地の七パーセントを超える土地を"
]
},
{
"start": 174.201,
"end": 176.272,
"lines": [
"すでに町や都市が占めていました"
]
},
{
"start": 176.872,
"end": 182.639,
"lines": [
"いちばん良い農地と　いちばん人が集まる場所が",
"同じ南の地域に重なっているのです"
]
},
{
"start": 184.239,
"end": 186.113,
"lines": [
"人も　南に集まります"
]
},
{
"start": 186.713,
"end": 189.95,
"lines": [
"二〇二一年　カナダ人の三人に二人は"
]
},
{
"start": 189.95,
"end": 194.122,
"lines": [
"アメリカとの南の",
"国境から百キロメートル以内に住んでいました"
]
},
{
"start": 194.722,
"end": 199.195,
"lines": [
"広い国の中で　人が暮らしているのは",
"南の端の細い帯です"
]
},
{
"start": 200.795,
"end": 203.987,
"lines": [
"南といっても　日本から見れば北の国です"
]
},
{
"start": 204.587,
"end": 208.468,
"lines": [
"カナダ最大の都市トロントは",
"北緯約四十三・七度"
]
},
{
"start": 209.068,
"end": 211.034,
"lines": [
"札幌とほぼ同じ緯度にあります"
]
},
{
"start": 211.634,
"end": 216.23,
"lines": [
"カナダの人の多くは　日本で",
"言えば北海道くらいの緯度で暮らしています"
]
},
{
"start": 217.83,
"end": 220.509,
"lines": [
"ここまでが　地理が教えてくれることです"
]
},
{
"start": 221.109,
"end": 223.603,
"lines": [
"地理は　人がどこに住めるかを決めます"
]
},
{
"start": 224.203,
"end": 229.043,
"lines": [
"北の凍土と岩の大地を除くと",
"人が暮らせる場所は南の帯に絞られます"
]
},
{
"start": 229.643,
"end": 232.557,
"lines": [
"ただし　ここで一つ気をつけたいことがあります"
]
},
{
"start": 233.157,
"end": 236.203,
"lines": [
"家が足りないのは　北の凍土の上ではありません"
]
},
{
"start": 236.803,
"end": 239.363,
"lines": [
"人が住んでいる　南の都市の中です"
]
},
{
"start": 240.963,
"end": 244.683,
"lines": [
"では　なぜ南の帯のあの場所に",
"都市ができたのか"
]
},
{
"start": 245.283,
"end": 246.135,
"lines": [
"歴史を見ます"
]
},
{
"start": 246.735,
"end": 250.101,
"lines": [
"一六〇八年　フランスの探検家シャンプランが"
]
},
{
"start": 250.101,
"end": 253.168,
"lines": [
"セントローレンス川のほと",
"りにケベックを建てました"
]
},
{
"start": 253.768,
"end": 258.458,
"lines": [
"ケベックとは　先住民の言葉で",
"川が狭まるところという意味です"
]
},
{
"start": 260.058,
"end": 263.397,
"lines": [
"フランスから来た入植者たちは",
"川沿いに住みました"
]
},
{
"start": 263.997,
"end": 266.913,
"lines": [
"川は　人も荷物も運ぶ道だったからです"
]
},
{
"start": 267.513,
"end": 270.981,
"lines": [
"土地は　できるだけ多くの",
"人が川岸に出られるよう"
]
},
{
"start": 270.981,
"end": 274.469,
"lines": [
"川に面した細長い短冊の形に分けられました"
]
},
{
"start": 276.069,
"end": 282.372,
"lines": [
"一六四二年には　川をさらにさかのぼった場所に",
"今のモントリオールの町ができました"
]
},
{
"start": 282.972,
"end": 289.097,
"lines": [
"大西洋から川をのぼってきた船が",
"急流に阻まれて　それ以上進めなくなる地点です"
]
},
{
"start": 289.697,
"end": 293.159,
"lines": [
"モントリオールは",
"毛皮の取引の中心になりました"
]
},
{
"start": 294.759,
"end": 297.474,
"lines": [
"モントリオールの街は　島の上にあります"
]
},
{
"start": 298.074,
"end": 303.99,
"lines": [
"オタワ川とセントローレンス川が合流する場所に",
"できた島々の中で　いちばん大きな島です"
]
},
{
"start": 304.59,
"end": 308.45,
"lines": [
"広さは約四百七十から四百八十平方キロメートル"
]
},
{
"start": 309.05,
"end": 311.897,
"lines": [
"四方を川に囲まれた　島の大都市です"
]
},
{
"start": 313.497,
"end": 318.781,
"lines": [
"一七九三年　オンタリオ湖の岸に",
"ヨークという町が建てられました"
]
},
{
"start": 319.381,
"end": 320.44,
"lines": [
"今のトロントです"
]
},
{
"start": 321.04,
"end": 325.877,
"lines": [
"砂州に守られた天然の港があり",
"入口が一つで守りやすい場所でした"
]
},
{
"start": 326.477,
"end": 328.882,
"lines": [
"今のトロント諸島が　その砂州です"
]
},
{
"start": 330.482,
"end": 332.847,
"lines": [
"西の都市を生んだのは　鉄道です"
]
},
{
"start": 333.447,
"end": 337.99,
"lines": [
"一八七一年",
"西の端のブリティッシュ・コロンビアは"
]
},
{
"start": 337.99,
"end": 342.781,
"lines": [
"東部とつなぐ大陸横断鉄道を約束されて",
"カナダに加わりました"
]
},
{
"start": 343.381,
"end": 349.623,
"lines": [
"そして一八八五年十一月七日",
"カナダ太平洋鉄道の最後の犬釘が打たれ"
]
},
{
"start": 349.623,
"end": 351.418,
"lines": [
"東と西がつながりました"
]
},
{
"start": 353.018,
"end": 355.958,
"lines": [
"この鉄道は　国の南寄りを走りました"
]
},
{
"start": 356.558,
"end": 362.492,
"lines": [
"一八八一年　鉄道会社は",
"測量技師が勧めた北寄りの峠ではなく"
]
},
{
"start": 362.492,
"end": 366.165,
"lines": [
"南寄りのキッキング・ホース峠を",
"通る経路に決めました"
]
},
{
"start": 366.765,
"end": 371.619,
"lines": [
"線路は　アメリカとの国境から遠くない所を",
"東西に結びました"
]
},
{
"start": 373.219,
"end": 377.236,
"lines": [
"鉄道と同じころ",
"国は大平原への入植を進めました"
]
},
{
"start": 377.836,
"end": 383.622,
"lines": [
"一八七二年の法律で",
"十ドルの手数料を払えば　百六十エーカー"
]
},
{
"start": 383.622,
"end": 386.654,
"lines": [
"約六十五ヘクタールの土地が与えられました"
]
},
{
"start": 387.254,
"end": 391.448,
"lines": [
"数年のうちに開墾して住めば",
"その土地は自分のものになりました"
]
},
{
"start": 393.048,
"end": 394.948,
"lines": [
"鉄道は　町も生みました"
]
},
{
"start": 395.548,
"end": 402.353,
"lines": [
"一八七五年　ボウ川とエルボー川の合流点に",
"砦が置かれ　のちのカルガリーになりました"
]
},
{
"start": 402.953,
"end": 407.568,
"lines": [
"一八八三年に鉄道が届き",
"翌年には町になりました"
]
},
{
"start": 408.168,
"end": 414.095,
"lines": [
"一八八六年には　太平洋岸の",
"グランビルがバンクーバー市になり　翌年"
]
},
{
"start": 414.095,
"end": 417.234,
"lines": [
"大陸横断の旅客列車が初めて着きました"
]
},
{
"start": 418.834,
"end": 423.632,
"lines": [
"こうして　川と湖と鉄道に沿って",
"南の帯に都市が並びました"
]
},
{
"start": 424.232,
"end": 428.988,
"lines": [
"ケベック　モントリオール",
"トロント　カルガリー　バンクーバー"
]
},
{
"start": 429.588,
"end": 432.509,
"lines": [
"今の大都市は　どれもこの帯の上にあります"
]
},
{
"start": 434.109,
"end": 437.025,
"lines": [
"今　カナダ人のほとんどは都市に住んでいます"
]
},
{
"start": 437.625,
"end": 443.03,
"lines": [
"二〇二一年　全体の七十三・七パーセント",
"ほぼ四人に三人が"
]
},
{
"start": 443.03,
"end": 447.376,
"lines": [
"人口十万人以上の四十一の",
"大都市圏で暮らしていました"
]
},
{
"start": 448.976,
"end": 452.685,
"lines": [
"反対に　農村に住む人の割合は減り続けています"
]
},
{
"start": 453.285,
"end": 457.661,
"lines": [
"二〇二一年",
"農村部に住む人は十七・八パーセント"
]
},
{
"start": 458.261,
"end": 460.889,
"lines": [
"国勢調査で九回続けて下がりました"
]
},
{
"start": 461.489,
"end": 464.356,
"lines": [
"人は　都市へ　都市へと集まっています"
]
},
{
"start": 465.956,
"end": 467.708,
"lines": [
"中でも大きいのが三つです"
]
},
{
"start": 468.308,
"end": 471.527,
"lines": [
"トロント大都市圏は約六百二十万人"
]
},
{
"start": 472.127,
"end": 474.69,
"lines": [
"モントリオールは約四百二十九万人"
]
},
{
"start": 475.29,
"end": 477.759,
"lines": [
"バンクーバーは約二百六十四万人"
]
},
{
"start": 478.359,
"end": 482.001,
"lines": [
"この三つだけで",
"全国の約三人に一人が住んでいます"
]
},
{
"start": 483.601,
"end": 486.208,
"lines": [
"州で見ても　偏りは大きくなります"
]
},
{
"start": 486.808,
"end": 492.574,
"lines": [
"東のオンタリオ州とケベック州の二つだけで",
"全国の人口の約六割が暮らしています"
]
},
{
"start": 494.174,
"end": 496.688,
"lines": [
"都市の中でも　人の動きがあります"
]
},
{
"start": 497.288,
"end": 501.659,
"lines": [
"二〇一六年から二〇二一年",
"トロント　モントリオール"
]
},
{
"start": 501.659,
"end": 509.0,
"lines": [
"バンクーバーの大都市圏で大きく伸びたのは",
"中心から車で三十分以上離れた　遠い郊外でした"
]
},
{
"start": 509.6,
"end": 513.951,
"lines": [
"街の中心で家を見つけられない人が",
"外へ外へと広がっています"
]
},
{
"start": 515.551,
"end": 517.675,
"lines": [
"ここで　トロントの街に寄ります"
]
},
{
"start": 518.275,
"end": 521.973,
"lines": [
"トロント市の面積は",
"約六百三十一平方キロメートル"
]
},
{
"start": 522.573,
"end": 524.971,
"lines": [
"東京二十三区とほぼ同じ広さです"
]
},
{
"start": 525.571,
"end": 530.365,
"lines": [
"ところが人口は約二百七十九万人で",
"二十三区の三割ほど"
]
},
{
"start": 530.965,
"end": 534.481,
"lines": [
"人口密度は　二十三区の三割にも届きません"
]
},
{
"start": 536.081,
"end": 537.753,
"lines": [
"西のバンクーバー市はどうか"
]
},
{
"start": 538.353,
"end": 543.328,
"lines": [
"人口は約六十六万人",
"面積は約百十五平方キロメートル"
]
},
{
"start": 543.928,
"end": 549.95,
"lines": [
"一平方キロメートルあたり約五千七百五十人で",
"カナダでは人口密度が高い街です"
]
},
{
"start": 550.55,
"end": 553.87,
"lines": [
"それでも　東京二十三区の半分にもなりません"
]
},
{
"start": 555.47,
"end": 558.817,
"lines": [
"では　家が足りなくなったのは　なぜ今なのか"
]
},
{
"start": 559.417,
"end": 561.134,
"lines": [
"まず　人が増えました"
]
},
{
"start": 561.734,
"end": 567.15,
"lines": [
"二〇二三年の一年間で",
"カナダの人口は約百二十七万人増えました"
]
},
{
"start": 567.75,
"end": 570.126,
"lines": [
"一九五七年以来の伸びです"
]
},
{
"start": 570.726,
"end": 573.893,
"lines": [
"増えた分のほとんどは　国の外から来た人でした"
]
},
{
"start": 575.493,
"end": 577.937,
"lines": [
"その後　人の増え方は変わりました"
]
},
{
"start": 578.537,
"end": 583.84,
"lines": [
"二〇二四年の増加は約七十四万人で",
"前の年より小さくなりました"
]
},
{
"start": 584.44,
"end": 589.227,
"lines": [
"国は二〇二四年十月",
"永住者の受け入れ目標を引き下げました"
]
},
{
"start": 589.827,
"end": 594.936,
"lines": [
"二〇二五年の七月から九月には",
"人口が前の三か月より減りました"
]
},
{
"start": 596.536,
"end": 599.71,
"lines": [
"家の数を決めるのは　人の数だけではありません"
]
},
{
"start": 600.31,
"end": 602.713,
"lines": [
"一つの家に何人で住むかも関わります"
]
},
{
"start": 603.313,
"end": 609.877,
"lines": [
"二〇二一年　カナダの一世帯あたりの人数は",
"平均二・四人で　過去最低になりました"
]
},
{
"start": 610.477,
"end": 615.605,
"lines": [
"一人暮らしの世帯が全体の",
"二十九・三パーセントで　いちばん多い形です"
]
},
{
"start": 617.205,
"end": 619.154,
"lines": [
"一方　建てる量はどうか"
]
},
{
"start": 619.754,
"end": 623.041,
"lines": [
"カナダで一年に建て始めた家が",
"いちばん多かったのは"
]
},
{
"start": 623.041,
"end": 626.804,
"lines": [
"一九七六年の約二十七万三千戸です"
]
},
{
"start": 627.404,
"end": 631.708,
"lines": [
"それから五十年近くたった今も",
"この記録を超えた年はありません"
]
},
{
"start": 632.308,
"end": 635.115,
"lines": [
"二〇二五年でも約二十五万九千戸"
]
},
{
"start": 635.715,
"end": 638.961,
"lines": [
"建てる量は　五十年前とほぼ同じ水準です"
]
},
{
"start": 640.561,
"end": 643.077,
"lines": [
"一九七〇年代と比べてみます"
]
},
{
"start": 643.677,
"end": 650.956,
"lines": [
"一九七二年から一九七九年",
"カナダでは年平均約二十四万戸の家が建ち始め"
]
},
{
"start": 650.956,
"end": 654.475,
"lines": [
"人口は年平均約二十八万人増えていました"
]
},
{
"start": 655.075,
"end": 658.494,
"lines": [
"家一戸あたり　人は一人ほど増えていた計算です"
]
},
{
"start": 660.094,
"end": 665.098,
"lines": [
"ある研究所が　人口の増え方と",
"建て始めた家の数を比べました"
]
},
{
"start": 665.698,
"end": 671.635,
"lines": [
"一九七二年から二〇二四年の平均では",
"家が一戸建ち始めるあいだに"
]
},
{
"start": 671.635,
"end": 674.067,
"lines": [
"人口は一・九人増えていました"
]
},
{
"start": 674.667,
"end": 677.582,
"lines": [
"それが二〇二三年には　五・一人"
]
},
{
"start": 678.182,
"end": 680.071,
"lines": [
"この期間でいちばん大きな差です"
]
},
{
"start": 681.671,
"end": 684.187,
"lines": [
"人口に対する家の数でも比べられます"
]
},
{
"start": 684.787,
"end": 691.575,
"lines": [
"ある銀行の計算では　二〇二〇年のカナダの",
"家の数は　人口千人あたり四百二十四戸"
]
},
{
"start": 692.175,
"end": 695.438,
"lines": [
"G7の七か国で　いちばん少ない数でした"
]
},
{
"start": 697.038,
"end": 698.973,
"lines": [
"では　どれだけ足りないのか"
]
},
{
"start": 699.573,
"end": 703.617,
"lines": [
"カナダ住宅金融公社の二〇二六年秋の報告では"
]
},
{
"start": 703.617,
"end": 708.151,
"lines": [
"二〇一九年ごろの手ごろさを",
"二〇三六年までに取り戻すには"
]
},
{
"start": 708.151,
"end": 712.6,
"lines": [
"一年に約四十二万戸から四十七万戸を",
"建てる必要があります"
]
},
{
"start": 713.2,
"end": 715.446,
"lines": [
"今の見込みは年約二十三万戸"
]
},
{
"start": 716.046,
"end": 718.184,
"lines": [
"必要な量の　約半分です"
]
},
{
"start": 719.784,
"end": 724.137,
"lines": [
"カナダ住宅金融公社は",
"値段が上がった理由も分析しました"
]
},
{
"start": 724.737,
"end": 730.359,
"lines": [
"人口の伸び　所得の伸び　そして低い金利で",
"家を求める人が増えました"
]
},
{
"start": 730.959,
"end": 733.787,
"lines": [
"一方　建てる量の伸びはほぼ一定でした"
]
},
{
"start": 734.387,
"end": 739.232,
"lines": [
"二〇一〇年代の後半から",
"求める量が建つ量を上回るようになりました"
]
},
{
"start": 740.832,
"end": 742.831,
"lines": [
"足りないと　何が起きるのか"
]
},
{
"start": 743.431,
"end": 748.749,
"lines": [
"二〇二三年　全国の賃貸住宅の",
"空き室の割合は一・五パーセント"
]
},
{
"start": 749.349,
"end": 754.06,
"lines": [
"一九八八年に記録を取り始めてから",
"いちばん低い値です"
]
},
{
"start": 754.66,
"end": 760.714,
"lines": [
"家を持つ費用も　二〇二三年の末には",
"平均的な世帯の所得の半分を大きく超え"
]
},
{
"start": 760.714,
"end": 763.427,
"lines": [
"記録が残る中で最も重くなりました"
]
},
{
"start": 765.027,
"end": 767.209,
"lines": [
"ここからは　都市の地図に寄ります"
]
},
{
"start": 767.809,
"end": 769.821,
"lines": [
"まず　西のバンクーバーです"
]
},
{
"start": 770.421,
"end": 777.061,
"lines": [
"バンクーバー市は　北をバラード入江　南を",
"フレーザー川　西を海に囲まれた半島にあります"
]
},
{
"start": 777.661,
"end": 780.886,
"lines": [
"入江の向こうには",
"ノースショアの山々が迫ります"
]
},
{
"start": 781.486,
"end": 786.277,
"lines": [
"街の南の低い土地は",
"フレーザー川が運んだ土砂でできた三角州です"
]
},
{
"start": 787.877,
"end": 792.49,
"lines": [
"大都市圏のメトロバンクーバーは",
"北と東を山に　西を海に"
]
},
{
"start": 792.49,
"end": 795.326,
"lines": [
"南をアメリカとの国境に挟まれています"
]
},
{
"start": 795.926,
"end": 799.034,
"lines": [
"広げたくても　広げる先が限られた街です"
]
},
{
"start": 799.634,
"end": 803.104,
"lines": [
"ここでは",
"地形が家を建てる場所を確かに狭めています"
]
},
{
"start": 804.704,
"end": 808.806,
"lines": [
"さらに　都市のまわりには",
"あえて開発しない土地があります"
]
},
{
"start": 809.406,
"end": 815.228,
"lines": [
"ブリティッシュ・コロンビア州は一九七三年",
"農地保全区域をつくりました"
]
},
{
"start": 815.828,
"end": 820.933,
"lines": [
"広さは約四百六十万ヘクタール",
"州の土地の約五パーセントです"
]
},
{
"start": 821.533,
"end": 825.532,
"lines": [
"この区域の農地には",
"家を建てて開発することができません"
]
},
{
"start": 827.132,
"end": 829.934,
"lines": [
"トロントのまわりにも　緑の帯があります"
]
},
{
"start": 830.534,
"end": 832.369,
"lines": [
"オンタリオ州のグリーンベルトです"
]
},
{
"start": 832.969,
"end": 837.756,
"lines": [
"二〇〇五年に指定され",
"東のライス湖の近くから西のナイアガラ川まで"
]
},
{
"start": 837.756,
"end": 839.842,
"lines": [
"約三百二十五キロメートル"
]
},
{
"start": 840.442,
"end": 846.526,
"lines": [
"農地や湿地　森を開発から守り　トロントと",
"ハミルトンの街を外側から囲んでいます"
]
},
{
"start": 848.126,
"end": 854.128,
"lines": [
"二〇二二年の末　州政府は住宅のために",
"このグリーンベルトの一部を外しました"
]
},
{
"start": 854.728,
"end": 860.305,
"lines": [
"ところが翌二〇二三年九月",
"州首相はそれを誤りだったと認めて撤回し"
]
},
{
"start": 860.305,
"end": 863.871,
"lines": [
"十二月には土地を元に戻す法律が成立しました"
]
},
{
"start": 864.471,
"end": 867.785,
"lines": [
"街の外へ広げる道は　簡単には開きません"
]
},
{
"start": 869.385,
"end": 872.724,
"lines": [
"ここまでは　地理と　守られた土地の話です"
]
},
{
"start": 873.324,
"end": 875.91,
"lines": [
"では　地理で全部説明できるのか"
]
},
{
"start": 876.51,
"end": 878.419,
"lines": [
"カナダ住宅金融公社は"
]
},
{
"start": 878.419,
"end": 882.376,
"lines": [
"二〇〇六年から二〇二四年の",
"家の値段を分析しました"
]
},
{
"start": 882.976,
"end": 887.346,
"lines": [
"カナダの家の供給が",
"アメリカと同じくらい需要に応えていれば"
]
},
{
"start": 887.346,
"end": 890.484,
"lines": [
"家の値段は約十パーセント低くなっていました"
]
},
{
"start": 891.084,
"end": 896.815,
"lines": [
"そして原因として　地理に加えて",
"用途地域の規制と人口の構成を挙げています"
]
},
{
"start": 898.415,
"end": 902.73,
"lines": [
"そこで　街の中の",
"家を建てる一つひとつの土地まで寄ります"
]
},
{
"start": 903.33,
"end": 907.008,
"lines": [
"トロント市の計画図で",
"住宅地は黄色に塗られています"
]
},
{
"start": 907.608,
"end": 913.119,
"lines": [
"この住宅地の約七割は　一戸建てか",
"二戸建てまでしか建てられない区域でした"
]
},
{
"start": 913.719,
"end": 917.731,
"lines": [
"集合住宅を建てるには",
"区域を変える手続きが必要です"
]
},
{
"start": 919.331,
"end": 920.437,
"lines": [
"州も動きました"
]
},
{
"start": 921.037,
"end": 928.171,
"lines": [
"オンタリオ州は二〇二二年十一月　上下水道が",
"通る都市の住宅地で　一つの区画に三戸まで"
]
},
{
"start": 928.171,
"end": 931.442,
"lines": [
"区域の変更なしで建てられる法律をつくりました"
]
},
{
"start": 932.042,
"end": 937.023,
"lines": [
"州は　二〇三一年までに",
"百五十万戸という目標を掲げています"
]
},
{
"start": 938.623,
"end": 944.085,
"lines": [
"カナダ住宅金融公社は　土地の使い方の",
"規制と家の値段の関係も調べました"
]
},
{
"start": 944.685,
"end": 945.809,
"lines": [
"結果は三つです"
]
},
{
"start": 946.409,
"end": 949.348,
"lines": [
"規制が厳しい都市ほど　家は手ごろではない"
]
},
{
"start": 949.948,
"end": 952.587,
"lines": [
"規制は　家が増えるペースを遅くする"
]
},
{
"start": 953.187,
"end": 956.556,
"lines": [
"そして　建て増しを望む声が",
"いちばん強い場所ほど"
]
},
{
"start": 956.556,
"end": 958.716,
"lines": [
"区域の変更が認められにくい"
]
},
{
"start": 960.316,
"end": 962.118,
"lines": [
"もう一つは　時間です"
]
},
{
"start": 962.718,
"end": 967.71,
"lines": [
"二〇二二年の自治体への調査では",
"建てるための承認にかかる時間が"
]
},
{
"start": 967.71,
"end": 971.865,
"lines": [
"地域ごとの家の手ごろさの差を",
"最もよく説明していました"
]
},
{
"start": 972.466,
"end": 977.165,
"lines": [
"トロントとバンクーバーの承認期間は",
"家が手ごろな地域の約四倍です"
]
},
{
"start": 978.765,
"end": 982.794,
"lines": [
"建設業者の団体も",
"承認にかかる期間を調べています"
]
},
{
"start": 983.394,
"end": 989.229,
"lines": [
"二〇二二年の調査では　トロントで",
"開発の承認を得るまでの平均は三十二か月"
]
},
{
"start": 989.829,
"end": 993.91,
"lines": [
"二〇二〇年の二十一か月から",
"約五割長くなりました"
]
},
{
"start": 994.51,
"end": 997.116,
"lines": [
"最も短い街は　三か月でした"
]
},
{
"start": 998.716,
"end": 1001.72,
"lines": [
"土地と許可があっても",
"まだ足りないものがあります"
]
},
{
"start": 1002.32,
"end": 1006.327,
"lines": [
"新しい家には",
"先に水道と下水を通す必要があります"
]
},
{
"start": 1006.927,
"end": 1012.192,
"lines": [
"カナダ自治体連合は二〇二三年",
"必要な家を支える自治体の設備に"
]
},
{
"start": 1012.192,
"end": 1015.51,
"lines": [
"最大で約六千億ドルかかると計算しました"
]
},
{
"start": 1016.11,
"end": 1018.29,
"lines": [
"そして　建てる人も減っていきます"
]
},
{
"start": 1018.89,
"end": 1025.287,
"lines": [
"これからの十年で　経験を積んだ建設の働き手",
"約二十七万人が引退を迎えます"
]
},
{
"start": 1026.887,
"end": 1030.134,
"lines": [
"家を建てるときには",
"自治体に払うお金もあります"
]
},
{
"start": 1030.734,
"end": 1035.407,
"lines": [
"道路や水道などの費用として",
"新しい家にかかる開発負担金です"
]
},
{
"start": 1036.007,
"end": 1041.388,
"lines": [
"カナダ住宅金融公社の二〇二五年の集計では",
"トロント市の一戸建ては"
]
},
{
"start": 1041.388,
"end": 1043.716,
"lines": [
"一戸あたり約十八万ドルでした"
]
},
{
"start": 1045.316,
"end": 1051.896,
"lines": [
"国は二〇二四年　住宅のための水道",
"下水　雨水の設備を早く整えるため"
]
},
{
"start": 1051.896,
"end": 1054.936,
"lines": [
"十年で六十億ドルの基金をつくりました"
]
},
{
"start": 1055.536,
"end": 1058.928,
"lines": [
"家を建てる前に　地面の下から準備が要るのです"
]
},
{
"start": 1060.528,
"end": 1062.992,
"lines": [
"カナダは　ここから動き始めました"
]
},
{
"start": 1063.592,
"end": 1070.274,
"lines": [
"二〇二三年五月　トロント市は",
"市内のすべての住宅地で　四戸までの集合住宅を"
]
},
{
"start": 1070.274,
"end": 1073.161,
"lines": [
"区域の変更なしで建てられるようにしました"
]
},
{
"start": 1073.761,
"end": 1078.684,
"lines": [
"九月にはバンクーバー市が",
"一戸建ての区域で三戸から六戸までを認めました"
]
},
{
"start": 1079.284,
"end": 1085.727,
"lines": [
"十一月には　ブリティッシュ・コロンビア州が",
"州の法律で同じ方向の決まりをつくりました"
]
},
{
"start": 1087.327,
"end": 1088.359,
"lines": [
"国も動きました"
]
},
{
"start": 1088.959,
"end": 1093.296,
"lines": [
"二〇二三年三月には",
"規則を変えて家を増やす自治体に"
]
},
{
"start": 1093.296,
"end": 1096.489,
"lines": [
"資金を出す四十億ドルの制度が始まりました"
]
},
{
"start": 1097.089,
"end": 1104.184,
"lines": [
"二〇二四年四月の国の住宅計画は",
"二〇三一年までに三百八十七万戸を掲げました"
]
},
{
"start": 1104.784,
"end": 1109.392,
"lines": [
"二〇二五年九月には",
"家を建てるペースを二倍にすることを目指す"
]
},
{
"start": 1109.392,
"end": 1111.897,
"lines": [
"新しい国の機関が発足しました"
]
},
{
"start": 1113.497,
"end": 1117.889,
"lines": [
"四十億ドルの制度で",
"トロント市は二〇二三年十二月"
]
},
{
"start": 1117.889,
"end": 1121.531,
"lines": [
"当時で最大の四億七千百万ドルを受け取りました"
]
},
{
"start": 1122.131,
"end": 1126.806,
"lines": [
"市は　これで約一万一千八百戸の",
"家を上乗せで建てる計画です"
]
},
{
"start": 1128.406,
"end": 1130.043,
"lines": [
"数字にも変化が出ています"
]
},
{
"start": 1130.643,
"end": 1137.205,
"lines": [
"二〇二五年に建て始めた家は約二十五万九千戸で",
"記録の上で五番目に多い年になりました"
]
},
{
"start": 1137.805,
"end": 1141.442,
"lines": [
"賃貸住宅の着工は　二年続けて過去最多です"
]
},
{
"start": 1142.042,
"end": 1147.331,
"lines": [
"賃貸の空き室の割合は",
"二〇二五年に三・一パーセントまで戻りました"
]
},
{
"start": 1147.931,
"end": 1153.44,
"lines": [
"家の値段の指数は　二〇二二年三月を頂点に",
"約二割下がりました"
]
},
{
"start": 1155.04,
"end": 1156.884,
"lines": [
"建つ家の中身も変わりました"
]
},
{
"start": 1157.484,
"end": 1162.073,
"lines": [
"今　建ち始める家の約六割は",
"貸すための賃貸住宅です"
]
},
{
"start": 1162.673,
"end": 1165.489,
"lines": [
"十年前は　二割にも届きませんでした"
]
},
{
"start": 1166.089,
"end": 1170.947,
"lines": [
"二〇二四年には",
"賃貸専用の住宅が四・一パーセント増え"
]
},
{
"start": 1170.947,
"end": 1173.939,
"lines": [
"三十年あまりで最大の増え方になりました"
]
},
{
"start": 1175.539,
"end": 1177.417,
"lines": [
"ここで　日本を見てみます"
]
},
{
"start": 1178.017,
"end": 1182.453,
"lines": [
"日本の用途地域は",
"法律で全国共通の十三種類です"
]
},
{
"start": 1183.053,
"end": 1186.277,
"lines": [
"そして住宅は",
"そのほとんどの区域で建てられます"
]
},
{
"start": 1186.877,
"end": 1192.438,
"lines": [
"二〇二三年　東京都だけで",
"約十二万八千戸の家が建ち始めました"
]
},
{
"start": 1193.038,
"end": 1195.574,
"lines": [
"同じ年のカナダ全国の約半分です"
]
},
{
"start": 1197.174,
"end": 1198.547,
"lines": [
"世界にも例があります"
]
},
{
"start": 1199.147,
"end": 1204.462,
"lines": [
"ニュージーランドのオークランドは",
"二〇一六年　住宅地の約四分の三で"
]
},
{
"start": 1204.462,
"end": 1206.302,
"lines": [
"建ててよい量を増やしました"
]
},
{
"start": 1206.902,
"end": 1212.494,
"lines": [
"その後の五年間で　許可された家は",
"計画がない場合より約五割多くなりました"
]
},
{
"start": 1213.094,
"end": 1214.742,
"lines": [
"アメリカのミネアポリスでは"
]
},
{
"start": 1214.742,
"end": 1219.21,
"lines": [
"二〇一七年から二〇二二年に",
"家の数が十二パーセント増え"
]
},
{
"start": 1219.21,
"end": 1221.687,
"lines": [
"家賃の上がり方は一パーセントでした"
]
},
{
"start": 1222.287,
"end": 1228.018,
"lines": [
"州のほかの地域では　家は四パーセント増え",
"家賃は十四パーセント上がりました"
]
},
{
"start": 1229.618,
"end": 1233.698,
"lines": [
"ただし　規則を変えるだけで",
"全部が解決するわけではありません"
]
},
{
"start": 1234.298,
"end": 1239.873,
"lines": [
"ミネアポリスで増えた家の約八十七パーセントは",
"二十戸以上の大きな建物でした"
]
},
{
"start": 1240.473,
"end": 1245.658,
"lines": [
"オークランドの研究者たちも　規制の",
"緩和だけでは万能ではないと結論しています"
]
},
{
"start": 1246.258,
"end": 1249.615,
"lines": [
"答えは一つではなく",
"いくつもの手を重ねることです"
]
},
{
"start": 1251.215,
"end": 1252.611,
"lines": [
"最初の問いに戻ります"
]
},
{
"start": 1253.211,
"end": 1255.879,
"lines": [
"こんなに広いのに　なぜ家が足りないのか"
]
},
{
"start": 1256.479,
"end": 1259.885,
"lines": [
"地理は　人が住む場所を南の細い帯に絞りました"
]
},
{
"start": 1260.485,
"end": 1263.547,
"lines": [
"人はその帯の都市に集まり　急に増えました"
]
},
{
"start": 1264.147,
"end": 1269.944,
"lines": [
"そして　人が集まる都市の中で　建ててよい量と",
"建てる速さが追いつきませんでした"
]
},
{
"start": 1270.544,
"end": 1273.03,
"lines": [
"カナダは　土地がない国ではありません"
]
},
{
"start": 1273.63,
"end": 1277.078,
"lines": [
"人が集まる場所で",
"家を建てる量が足りない国です"
]
},
{
"start": 1278.678,
"end": 1282.326,
"lines": [
"カナダ住宅金融公社は　今ある人手と資源でも"
]
},
{
"start": 1282.326,
"end": 1286.743,
"lines": [
"一年に四十万戸を超える家を",
"建てる力があると計算しています"
]
},
{
"start": 1287.343,
"end": 1291.071,
"lines": [
