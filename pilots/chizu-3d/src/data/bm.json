"subs": [
{
"start": 0.0,
"end": 2.368,
"lines": [
"大西洋に浮かぶ島　バミューダ"
]
},
{
"start": 2.968,
"end": 6.913,
"lines": [
"この島の家々の屋根は",
"白い階段のような形をしています"
]
},
{
"start": 7.513,
"end": 10.356,
"lines": [
"この屋根の下に　家族の飲み水があります"
]
},
{
"start": 10.956,
"end": 16.528,
"lines": [
"川もなく　淡水の湖もない島で",
"人々は雨を屋根で受け止めて暮らしています"
]
},
{
"start": 17.128,
"end": 20.735,
"lines": [
"では　雨が降らないとき　島の人はどうするのか"
]
},
{
"start": 21.335,
"end": 26.263,
"lines": [
"今日は　空から落ちた一滴の雨の行き先を",
"地図で最後まで追いかけます"
]
},
{
"start": 26.863,
"end": 30.076,
"lines": [
"島の地面の下　四百年あまり前の遭難"
]
},
{
"start": 30.076,
"end": 34.234,
"lines": [
"家の下のタンクを決めた法律",
"日照りの年の綱渡り"
]
},
{
"start": 34.234,
"end": 36.236,
"lines": [
"そして世界の雨の受け皿へ"
]
},
{
"start": 36.836,
"end": 37.873,
"lines": [
"順に見ていきます"
]
},
{
"start": 39.473,
"end": 41.143,
"lines": [
"まず　島の場所です"
]
},
{
"start": 41.743,
"end": 46.602,
"lines": [
"バミューダは　北アメリカのハッテラス岬から",
"東南東へおよそ千キロ"
]
},
{
"start": 47.202,
"end": 50.199,
"lines": [
"いちばん近い陸地まで　それだけ離れています"
]
},
{
"start": 50.799,
"end": 52.447,
"lines": [
"緯度は北緯約三十二度"
]
},
{
"start": 53.047,
"end": 57.102,
"lines": [
"この緯度にしては暖かく",
"一年を通して亜熱帯の気候です"
]
},
{
"start": 57.702,
"end": 61.676,
"lines": [
"島の近くを",
"暖かいメキシコ湾流が流れているからです"
]
},
{
"start": 63.276,
"end": 67.202,
"lines": [
"島の面積は　約五十三平方キロメートル"
]
},
{
"start": 67.802,
"end": 73.094,
"lines": [
"二〇一六年の国勢調査では",
"約六万四千人が暮らしています"
]
},
{
"start": 73.694,
"end": 76.872,
"lines": [
"一平方キロメートルあたり　約千二百人"
]
},
{
"start": 77.472,
"end": 80.204,
"lines": [
"小さな島に　たくさんの人が住んでいます"
]
},
{
"start": 80.804,
"end": 84.003,
"lines": [
"この人数の毎日の水を　どこから得ているのか"
]
},
{
"start": 84.603,
"end": 85.837,
"lines": [
"それが今日の問いです"
]
},
{
"start": 87.437,
"end": 89.234,
"lines": [
"地図で島の形を見てみます"
]
},
{
"start": 89.834,
"end": 95.926,
"lines": [
"バミューダは　いくつもの島が橋や道でつながり",
"東西に細長く弓のように曲がっています"
]
},
{
"start": 96.526,
"end": 100.245,
"lines": [
"東の端には　最初の入植地セント・ジョージズ"
]
},
{
"start": 100.845,
"end": 102.849,
"lines": [
"島の中央には　デヴォンシャー"
]
},
{
"start": 103.449,
"end": 105.372,
"lines": [
"西の端には　サマセット"
]
},
{
"start": 105.972,
"end": 110.352,
"lines": [
"この細長い島の上に",
"家々の白い屋根が点々と並んでいます"
]
},
{
"start": 110.952,
"end": 114.584,
"lines": [
"今日の話に出てくる場所は",
"すべてこの地図の上にあります"
]
},
{
"start": 116.184,
"end": 120.223,
"lines": [
"答えを探す前に",
"この島が何でできているのかを見ておきます"
]
},
{
"start": 120.823,
"end": 125.389,
"lines": [
"バミューダの島々は",
"海の底からそびえる古い火山の上に乗っています"
]
},
{
"start": 125.989,
"end": 130.453,
"lines": [
"数千万年前の火山が",
"波に削られて頭を平らにされました"
]
},
{
"start": 131.053,
"end": 135.747,
"lines": [
"その上に　サンゴや貝のかけらが積もり",
"石灰岩の層ができました"
]
},
{
"start": 136.347,
"end": 140.406,
"lines": [
"層の厚さは",
"場所によって約十五メートルから百メートルです"
]
},
{
"start": 142.006,
"end": 145.242,
"lines": [
"島の石灰岩の多くは　もともと浜の砂です"
]
},
{
"start": 145.842,
"end": 150.228,
"lines": [
"サンゴや貝のかけらでできた砂が",
"風で吹き寄せられて砂丘になり"
]
},
{
"start": 150.228,
"end": 152.768,
"lines": [
"それが長い時間をかけて固まりました"
]
},
{
"start": 153.368,
"end": 157.268,
"lines": [
"つまり　この島の地面は",
"すき間の多い石でできています"
]
},
{
"start": 158.868,
"end": 161.929,
"lines": [
"すき間の多い石灰岩は　水をよく通します"
]
},
{
"start": 162.529,
"end": 166.861,
"lines": [
"降った雨は　地面の上を流れずに",
"すぐに地中へしみ込みます"
]
},
{
"start": 167.461,
"end": 171.483,
"lines": [
"だからこの島には　川も　淡水の湖もありません"
]
},
{
"start": 172.083,
"end": 175.112,
"lines": [
"池はありますが　その水は塩を含んでいます"
]
},
{
"start": 176.712,
"end": 179.207,
"lines": [
"では　しみ込んだ雨はどこへ行くのか"
]
},
{
"start": 179.807,
"end": 182.491,
"lines": [
"島の地下は　海水で満たされています"
]
},
{
"start": 183.091,
"end": 185.661,
"lines": [
"海水は　淡水より少しだけ重い"
]
},
{
"start": 186.261,
"end": 191.706,
"lines": [
"そのため　しみ込んだ雨水は",
"海水の上に　薄い層となって浮かびます"
]
},
{
"start": 192.306,
"end": 197.697,
"lines": [
"地下の淡水の層は　横から見ると",
"真ん中がふくらんだレンズの形をしています"
]
},
{
"start": 199.297,
"end": 201.935,
"lines": [
"このレンズには　決まった関係があります"
]
},
{
"start": 202.535,
"end": 208.225,
"lines": [
"地下の淡水の水面が",
"海面より一センチ高ければ　淡水は海面より下へ"
]
},
{
"start": 208.225,
"end": 210.906,
"lines": [
"およそ四十センチの深さまで届きます"
]
},
{
"start": 211.506,
"end": 218.396,
"lines": [
"逆に　くみ上げすぎて水面が一センチ下がると",
"淡水の層は下からおよそ四十センチ薄くなり"
]
},
{
"start": 218.396,
"end": 221.055,
"lines": [
"その分　重い海水が入り込みます"
]
},
{
"start": 221.655,
"end": 226.22,
"lines": [
"地下の淡水は　くみ上げ方を誤ると",
"すぐに塩水に変わります"
]
},
{
"start": 227.82,
"end": 233.253,
"lines": [
"バミューダでいちばん大きな淡水のレンズは",
"島の中央　デヴォンシャーの地下にあります"
]
},
{
"start": 233.853,
"end": 235.862,
"lines": [
"広さは約七平方キロメートル"
]
},
{
"start": 236.462,
"end": 240.254,
"lines": [
"島でくみ上げる地下水の大半は",
"このレンズから来ています"
]
},
{
"start": 240.853,
"end": 246.867,
"lines": [
"一九七五年には水資源法ができ",
"地下の淡水は保護区域として守られています"
]
},
{
"start": 247.467,
"end": 253.735,
"lines": [
"政府は五年ごとに　約三千百件の水利権を出し",
"井戸から使える量を管理しています"
]
},
{
"start": 255.335,
"end": 258.419,
"lines": [
"このレンズは　きれいな左右対称ではありません"
]
},
{
"start": 259.019,
"end": 263.582,
"lines": [
"島の北側と南側では",
"地下の岩の水の通しやすさが違います"
]
},
{
"start": 264.182,
"end": 268.175,
"lines": [
"そのため　淡水の層の形も　北と南で違います"
]
},
{
"start": 268.775,
"end": 274.144,
"lines": [
"地下の水は　岩の性質に合わせて形を変えながら",
"海水の上に浮いています"
]
},
{
"start": 274.744,
"end": 278.774,
"lines": [
"目に見えないこの水を",
"島は法律で守りながら使っています"
]
},
{
"start": 280.374,
"end": 284.54,
"lines": [
"では　人々はいつから",
"この島で水の工夫をしてきたのか"
]
},
{
"start": 285.14,
"end": 287.621,
"lines": [
"一六〇九年七月二十八日"
]
},
{
"start": 288.221,
"end": 291.405,
"lines": [
"アメリカのジェームズタウンへ",
"向かっていたイギリスの船"
]
},
{
"start": 291.405,
"end": 295.656,
"lines": [
"シー・ヴェンチャー号が",
"嵐にあってバミューダの岩礁に乗り上げました"
]
},
{
"start": 296.256,
"end": 299.403,
"lines": [
"乗っていた人は　全員が島に上陸しました"
]
},
{
"start": 300.003,
"end": 303.966,
"lines": [
"遭難者たちは",
"船の残骸と島の木で二隻の船を造り"
]
},
{
"start": 303.966,
"end": 307.249,
"lines": [
"一六一〇年にジェームズタウンへ",
"たどり着きました"
]
},
{
"start": 308.849,
"end": 315.314,
"lines": [
"一六一二年　プラウ号が入植者を乗せて到着し",
"総督リチャード・ムーアのもとで"
]
},
{
"start": 315.314,
"end": 317.784,
"lines": [
"本格的な入植が始まりました"
]
},
{
"start": 318.384,
"end": 323.952,
"lines": [
"人々は最初　スミス島に住み　その後",
"セント・ジョージズへ移りました"
]
},
{
"start": 324.552,
"end": 327.554,
"lines": [
"こうして　川のない島での暮らしが始まります"
]
},
{
"start": 329.154,
"end": 331.741,
"lines": [
"人々が頼ったのが　島の石でした"
]
},
{
"start": 332.341,
"end": 334.877,
"lines": [
"地元で切り出した石灰岩を板にして"
]
},
{
"start": 334.877,
"end": 338.364,
"lines": [
"木の垂木の上に重ね",
"セメントで上を塗り固めます"
]
},
{
"start": 338.964,
"end": 342.942,
"lines": [
"そして島の石灰窯で焼いた石灰で",
"屋根を白く塗りました"
]
},
{
"start": 343.542,
"end": 346.524,
"lines": [
"こうして　白い階段のような屋根ができました"
]
},
{
"start": 348.124,
"end": 352.715,
"lines": [
"昔は　雨水をためるタンクを",
"家の横の石造りの小屋に置き"
]
},
{
"start": 352.715,
"end": 355.106,
"lines": [
"石の雨どいで屋根とつないでいました"
]
},
{
"start": 355.706,
"end": 360.33,
"lines": [
"一八〇九年に描かれた絵にも",
"水をためる施設が描かれています"
]
},
{
"start": 361.93,
"end": 365.664,
"lines": [
"では　今の家で",
"雨がどう流れるのかを追ってみます"
]
},
{
"start": 366.264,
"end": 370.022,
"lines": [
"屋根に落ちた雨は",
"階段のような段を一段ずつ下ります"
]
},
{
"start": 370.622,
"end": 372.457,
"lines": [
"段は　強い雨の勢いを弱め"
]
},
{
"start": 372.457,
"end": 376.433,
"lines": [
"屋根の下の端の雨どいで",
"受け止められるようにしています"
]
},
{
"start": 377.033,
"end": 381.882,
"lines": [
"雨どいに集まった水は　縦の管を通って",
"家の下のタンクへ落ちます"
]
},
{
"start": 382.482,
"end": 388.186,
"lines": [
"タンクがいっぱいになると　あふれた水は",
"地面から少し上に出した管から外へ出ます"
]
},
{
"start": 388.786,
"end": 391.691,
"lines": [
"その管の口は　細かい金網でふさぎます"
]
},
{
"start": 393.291,
"end": 395.344,
"lines": [
"金網には　理由があります"
]
},
{
"start": 395.944,
"end": 399.225,
"lines": [
"水がたまるタンクは",
"蚊にとって格好のすみかです"
]
},
{
"start": 399.825,
"end": 405.944,
"lines": [
"政府の蚊の対策の担当者は",
"一年中島を見回り　夏は特に念入りに調べます"
]
},
{
"start": 406.544,
"end": 410.19,
"lines": [
"タンクのふたはしっかり閉め",
"あふれ管には網をかぶせる"
]
},
{
"start": 410.79,
"end": 413.455,
"lines": [
"家の下の水は　こうして守られています"
]
},
{
"start": 415.055,
"end": 418.475,
"lines": [
"この仕組みは",
"一軒一軒の思いつきではありません"
]
},
{
"start": 419.075,
"end": 422.175,
"lines": [
"一九五一年の規則は　人が住む建物に"
]
},
{
"start": 422.175,
"end": 426.735,
"lines": [
"屋根の五分の四以上を",
"雨を集める面にすること　そして"
]
},
{
"start": 426.735,
"end": 430.479,
"lines": [
"その面十平方フィートごとに",
"百ガロンの水をためるタンクを"
]
},
{
"start": 430.479,
"end": 431.866,
"lines": [
"持つことを求めました"
]
},
{
"start": 432.466,
"end": 437.987,
"lines": [
"屋根全体で計算し直すと",
"屋根一平方メートルあたり約三百九十リットル"
]
},
{
"start": 438.587,
"end": 445.255,
"lines": [
"屋根が百平方メートルの家なら",
"約三十九トンの水を　家の下にためる計算です"
]
},
{
"start": 446.855,
"end": 451.769,
"lines": [
"保健当局は　家のタンクに",
"どれだけ水が入るかの求め方も示しています"
]
},
{
"start": 452.369,
"end": 456.517,
"lines": [
"タンクの縦　横　深さをかけて　容積を出します"
]
},
{
"start": 457.117,
"end": 462.572,
"lines": [
"たとえば　縦四メートル　横四メートル",
"深さ二・五メートルのタンクなら"
]
},
{
"start": 462.572,
"end": 464.226,
"lines": [
"四十立方メートル"
]
},
{
"start": 464.826,
"end": 466.745,
"lines": [
"四万リットルの水が入ります"
]
},
{
"start": 467.345,
"end": 472.014,
"lines": [
"家族は　この大きなタンクの水位を見ながら",
"毎日の水を使います"
]
},
{
"start": 473.614,
"end": 477.037,
"lines": [
"屋根にどれだけの水が集まるのかも",
"計算できます"
]
},
{
"start": 477.637,
"end": 482.113,
"lines": [
"一平方メートルの屋根に一ミリの雨が降ると",
"水は一リットルです"
]
},
{
"start": 482.713,
"end": 486.434,
"lines": [
"屋根が百平方メートルなら",
"十ミリの雨で千リットル"
]
},
{
"start": 487.034,
"end": 490.369,
"lines": [
"一トンの水が　一度の雨でタンクに流れ込みます"
]
},
{
"start": 490.969,
"end": 493.699,
"lines": [
"屋根の広さが　そのまま水の量になる"
]
},
{
"start": 494.299,
"end": 498.202,
"lines": [
"だから規則は　タンクの大きさを",
"屋根の広さで決めていました"
]
},
{
"start": 499.802,
"end": 502.327,
"lines": [
"屋根は　家族の水道の入口です"
]
},
{
"start": 502.927,
"end": 505.717,
"lines": [
"だから手入れも　衛生の仕事になります"
]
},
{
"start": 506.317,
"end": 510.719,
"lines": [
"政府の案内では",
"タンクの掃除は少なくとも六年に一回で"
]
},
{
"start": 510.719,
"end": 512.48,
"lines": [
"これが法律の上限です"
]
},
{
"start": 513.08,
"end": 515.636,
"lines": [
"屋根は二年ごとに掃除か塗り直しをします"
]
},
{
"start": 516.236,
"end": 522.599,
"lines": [
"塗り直す前には　古い塗料とカビを落とし",
"漂白剤と水を半分ずつ混ぜた液で洗います"
]
},
{
"start": 523.199,
"end": 527.483,
"lines": [
"その間は　縦の管をふさいで",
"汚れた水をタンクに入れません"
]
},
{
"start": 528.083,
"end": 531.124,
"lines": [
"塗るのは　政府が認めた屋根用の塗料です"
]
},
{
"start": 532.724,
"end": 538.626,
"lines": [
"保健当局は　飲み水や料理に使うタンクの水を",
"消毒するよう強く勧めています"
]
},
{
"start": 539.226,
"end": 543.037,
"lines": [
"二〇〇八年には",
"無作為に選んだ百二の家のタンクの水を"
]
},
{
"start": 543.037,
"end": 544.561,
"lines": [
"調べた研究があります"
]
},
{
"start": 545.161,
"end": 549.645,
"lines": [
"前の年にタンクを掃除した家ほど",
"水の汚れが少ない結果でした"
]
},
{
"start": 550.245,
"end": 554.847,
"lines": [
"保健当局は　水の検査結果の",
"読み方をまとめた資料も出しています"
]
},
{
"start": 555.447,
"end": 558.964,
"lines": [
"消毒のあとに検査をすれば",
"効果を確かめられます"
]
},
{
"start": 559.564,
"end": 563.422,
"lines": [
"屋根とタンクの手入れが",
"そのまま家族の健康につながります"
]
},
{
"start": 565.022,
"end": 568.056,
"lines": [
"この島の屋根には　もう一つの役目があります"
]
},
{
"start": 568.656,
"end": 572.228,
"lines": [
"バミューダは",
"大西洋のハリケーンの通り道にあります"
]
},
{
"start": 572.828,
"end": 579.327,
"lines": [
"二〇〇三年九月五日　ハリケーン・ファビアンが",
"島を直撃し　島で四人が亡くなりました"
]
},
{
"start": 579.927,
"end": 584.486,
"lines": [
"二〇一六年十月十三日には",
"ハリケーン・ニコールの目が"
]
},
{
"start": 584.486,
"end": 588.724,
"lines": [
"二〇二〇年九月十四日には",
"ハリケーン・ポーレットの目が"
]
},
{
"start": 588.724,
"end": 590.328,
"lines": [
"島の真上を通りました"
]
},
{
"start": 590.928,
"end": 596.406,
"lines": [
"二〇二四年八月十七日には",
"ハリケーン・アーネストが上陸しました"
]
},
{
"start": 597.006,
"end": 600.906,
"lines": [
"最大風速は　一秒あたり約三十八メートルでした"
]
},
{
"start": 601.506,
"end": 605.65,
"lines": [
"島の空は　雨を運ぶだけでなく",
"嵐も運んできます"
]
},
{
"start": 607.25,
"end": 611.486,
"lines": [
"石灰岩の屋根は重く",
"その重さが風に耐える理由の一つです"
]
},
{
"start": 612.086,
"end": 617.427,
"lines": [
"二〇〇三年当時の建築の基準は",
"一秒あたり約四十九メートルの風と"
]
},
{
"start": 617.427,
"end": 621.881,
"lines": [
"瞬間的には約六十七メートルの風に",
"耐える家を求めていました"
]
},
{
"start": 622.481,
"end": 627.062,
"lines": [
"それでもファビアンでは",
"伝統的な石の屋根の建物のかなりの数が"
]
},
{
"start": 627.062,
"end": 628.799,
"lines": [
"屋根の一部を失いました"
]
},
{
"start": 629.399,
"end": 633.213,
"lines": [
"雨を集める屋根は",
"嵐に耐える屋根でもなければなりません"
]
},
{
"start": 634.813,
"end": 637.885,
"lines": [
"それでも　雨は毎年同じようには降りません"
]
},
{
"start": 638.485,
"end": 642.106,
"lines": [
"雨が少ない時期には",
"家のタンクの水が足りなくなります"
]
},
{
"start": 642.706,
"end": 646.044,
"lines": [
"そのとき住民は　給水トラックから水を買います"
]
},
{
"start": 646.644,
"end": 651.254,
"lines": [
"二〇二二年からは",
"トラック一台分の配達が百二十ドルです"
]
},
{
"start": 651.854,
"end": 656.103,
"lines": [
"給水トラックの業者は",
"タンクに常に一〜二週間分の水を"
]
},
{
"start": 656.103,
"end": 657.803,
"lines": [
"残すよう勧めています"
]
},
{
"start": 659.403,
"end": 662.198,
"lines": [
"では　政府の水道はどうなっているのか"
]
},
{
"start": 662.798,
"end": 669.863,
"lines": [
"二〇一八年の大臣の説明では　政府の水道管に",
"つながっているのは　約二千の家と事業所"
]
},
{
"start": 669.863,
"end": 671.548,
"lines": [
"そして病院などだけです"
]
},
{
"start": 672.148,
"end": 676.594,
"lines": [
"それでも　政府の水は",
"島の三分の二の家の安全網です"
]
},
{
"start": 677.194,
"end": 681.463,
"lines": [
"日照りのときには",
"約四万人がトラックの水に頼ります"
]
},
{
"start": 682.063,
"end": 689.391,
"lines": [
"島の水道は　一軒一軒の屋根とタンクが主役で",
"公共の水は　それを後ろから支える仕組みです"
]
},
{
"start": 690.991,
"end": 695.143,
"lines": [
"トラックの水の元の一つが",
"島の中央の北の海岸にある"
]
},
{
"start": 695.143,
"end": 698.056,
"lines": [
"タインズ・ベイの逆浸透プラントです"
]
},
{
"start": 698.656,
"end": 704.39,
"lines": [
"海水に強い圧力をかけ　細かい膜を通して",
"塩を取り除いた真水をつくります"
]
},
{
"start": 704.99,
"end": 707.529,
"lines": [
"第一期は二〇〇九年に完成しました"
]
},
{
"start": 708.129,
"end": 713.509,
"lines": [
"二〇二一年の大臣の説明では",
"一日に約七十五万ガロンをつくり"
]
},
{
"start": 713.509,
"end": 715.782,
"lines": [
"ほぼ最大の能力で動いています"
]
},
{
"start": 716.382,
"end": 722.647,
"lines": [
"二〇一八年には　取水の井戸を増やして",
"一日百万ガロンに上げる計画も示されました"
]
},
{
"start": 723.247,
"end": 727.8,
"lines": [
"島には　民間の水道会社もあり",
"水をつくって配っています"
]
},
{
"start": 728.4,
"end": 732.01,
"lines": [
"島の水は　政府と民間がつぎはぎで支えています"
]
},
{
"start": 733.61,
"end": 737.101,
"lines": [
"その仕組みが揺らいだのが",
"二〇二五年の初めです"
]
},
{
"start": 737.701,
"end": 742.809,
"lines": [
"一月十二日　タインズ・ベイに",
"海水を送る設備が大きく故障し"
]
},
{
"start": 742.809,
"end": 746.069,
"lines": [
"水道とトラックの出口の水が制限されました"
]
},
{
"start": 746.669,
"end": 752.904,
"lines": [
"二月の雨は平年より約六十四ミリ少なく",
"給水トラック用の東部の出口は閉まりました"
]
},
{
"start": 753.504,
"end": 756.709,
"lines": [
"屋根の雨が足りず　海水からつくる水も止まる"
]
},
{
"start": 757.309,
"end": 761.505,
"lines": [
"島の水は　二つの柱の両方が",
"細る事態に直面しました"
]
},
{
"start": 763.105,
"end": 770.235,
"lines": [
"二〇二五年七月　政府は住民に",
"家のタンクの残りを確かめ　空になる前に注文し"
]
},
{
"start": 770.235,
"end": 772.818,
"lines": [
"早めに節水するよう呼びかけました"
]
},
{
"start": 773.418,
"end": 780.131,
"lines": [
"そして二〇二六年五月四日　島の東部に",
"給水トラック用の新しい出口が開きました"
]
},
{
"start": 780.731,
"end": 784.044,
"lines": [
"二十四時間使え　二台が同時に水をくめます"
]
},
{
"start": 784.644,
"end": 787.511,
"lines": [
"東の端のセント・ジョージズの業者は"
]
},
{
"start": 787.511,
"end": 791.726,
"lines": [
"政府の採石場まで水をくみに",
"往復しなくて済むようになりました"
]
},
{
"start": 792.326,
"end": 796.458,
"lines": [
"島の東部では",
"一日二十万ガロンの逆浸透プラントと"
]
},
{
"start": 796.458,
"end": 799.843,
"lines": [
"新しい水道の本管の整備も進められています"
]
},
{
"start": 801.443,
"end": 804.095,
"lines": [
"ここで　一滴の雨の道をまとめます"
]
},
{
"start": 804.695,
"end": 806.754,
"lines": [
"雨は　白い屋根の段を下り"
]
},
{
"start": 806.754,
"end": 811.043,
"lines": [
"雨どいから縦の管を通って",
"家の下のタンクにたまります"
]
},
{
"start": 811.643,
"end": 815.431,
"lines": [
"地面にしみ込んだ雨は",
"地下で海水の上に浮くレンズになり"
]
},
{
"start": 815.431,
"end": 817.18,
"lines": [
"井戸からくみ上げられます"
]
},
{
"start": 817.78,
"end": 823.445,
"lines": [
"雨が足りなければ　海水からつくった真水を",
"給水トラックが家のタンクへ運びます"
]
},
{
"start": 824.045,
"end": 826.032,
"lines": [
"屋根　地下　海"
]
},
{
"start": 826.632,
"end": 831.284,
"lines": [
"三つの水源を組み合わせて",
"六万人を超える人の暮らしが回っています"
]
},
{
"start": 832.884,
"end": 835.159,
"lines": [
"ここで　世界地図に目を移します"
]
},
{
"start": 835.759,
"end": 840.241,
"lines": [
"雨を屋根や斜面で集めて暮らしてきた場所は",
"バミューダだけではありません"
]
},
{
"start": 841.841,
"end": 846.09,
"lines": [
"地中海の入口",
"イベリア半島の南の端にあるジブラルタル"
]
},
{
"start": 846.69,
"end": 852.027,
"lines": [
"岩山の東側の砂の斜面には",
"かつて一面に波形の鉄板が張られていました"
]
},
{
"start": 852.627,
"end": 857.132,
"lines": [
"斜面で受けた雨は",
"岩山の中をくりぬいた貯水池へ流れ込みました"
]
},
{
"start": 857.732,
"end": 863.444,
"lines": [
"最初の四つの貯水池は",
"一八九八年から一九〇〇年にかけて掘られました"
]
},
{
"start": 864.044,
"end": 868.369,
"lines": [
"鉄板の広さは　一九〇三年の約十エーカーから"
]
},
{
"start": 868.369,
"end": 873.073,
"lines": [
"一九一一年から一九一四年にかけて",
"二十四エーカー"
]
},
{
"start": 873.073,
"end": 877.253,
"lines": [
"一九六一年には三十四エーカーに広がりました"
]
},
{
"start": 877.853,
"end": 885.671,
"lines": [
"しかし　海水から真水をつくる設備ができると",
"斜面の集水は一九九三年十月に役目を終え"
]
},
{
"start": 885.671,
"end": 887.536,
"lines": [
"鉄板は取り外されました"
]
},
{
"start": 889.136,
"end": 893.199,
"lines": [
"赤道の少し北",
"太平洋のマーシャル諸島の首都マジュロでは"
]
},
{
"start": 893.199,
"end": 895.653,
"lines": [
"空港の滑走路が雨の受け皿です"
]
},
{
"start": 896.253,
"end": 899.994,
"lines": [
"滑走路に降った雨を集め",
"処理して貯水池へ送ります"
]
},
{
"start": 900.594,
"end": 905.077,
"lines": [
"日照りが長引くと",
"島の地下の淡水のレンズからくみ上げて補います"
]
},
{
"start": 905.677,
"end": 908.452,
"lines": [
"バミューダと同じ　地下に浮かぶ淡水です"
]
},
{
"start": 909.052,
"end": 914.721,
"lines": [
"南の島国ツバルの首都フナフティには",
"川も湖もなく　真水は雨水だけです"
]
},
{
"start": 915.321,
"end": 919.261,
"lines": [
"家ごとのタンクと",
"共同のタンクに雨をためて暮らしています"
]
},
{
"start": 919.861,
"end": 926.465,
"lines": [
"二〇一一年　雨がほとんど降らない日が続き",
"ツバル政府は国家非常事態を宣言しました"
]
},
{
"start": 927.065,
"end": 933.958,
"lines": [
"ニュージーランドが　十月三日から水と物資を",
"空から運び　赤十字の淡水化の装置も動きました"
]
},
{
"start": 935.558,
"end": 939.674,
"lines": [
"カリブ海の",
"プエルトリコの東にある米領ヴァージン諸島にも"
]
},
{
"start": 939.674,
"end": 942.363,
"lines": [
"雨水のタンクを求める法律があります"
]
},
{
"start": 942.963,
"end": 948.558,
"lines": [
"二〇一九年版の法典では　住宅やホテルに",
"屋根一平方メートルあたり"
]
},
{
"start": 948.558,
"end": 955.014,
"lines": [
"一階建てで約四百十リットル　二階建て以上で",
"約六百十リットルのタンクを求めています"
]
},
{
"start": 956.614,
"end": 959.559,
"lines": [
"雨水のタンクは　大陸の国にもあります"
]
},
{
"start": 960.159,
"end": 967.465,
"lines": [
"オーストラリアでは　二〇一三年の統計で",
"約二十六パーセント　二百三十万を超える世帯が"
]
},
{
"start": 967.465,
"end": 969.664,
"lines": [
"雨水のタンクを使っていました"
]
},
{
"start": 970.264,
"end": 976.191,
"lines": [
"南オーストラリア州では四十六パーセント",
"クイーンズランド州では三十四パーセント"
]
},
{
"start": 976.191,
"end": 978.879,
"lines": [
"ビクトリア州では二十九パーセントです"
]
},
{
"start": 979.479,
"end": 980.929,
"lines": [
"日本にも例があります"
]
},
{
"start": 981.529,
"end": 989.021,
"lines": [
"一九八五年に完成した東京の両国国技館は",
"約八千四百平方メートルの大屋根の雨を"
]
},
{
"start": 989.021,
"end": 991.947,
"lines": [
"地下の約千トンのタンクにためています"
]
},
{
"start": 992.547,
"end": 996.795,
"lines": [
"この水は　トイレの水と",
"災害に備える水に使われます"
]
},
{
"start": 997.395,
"end": 1001.958,
"lines": [
"二〇一四年には",
"雨水の利用を進める法律が施行されました"
]
},
{
"start": 1002.558,
"end": 1008.097,
"lines": [
"翌年には　国などが建てる建物に",
"雨水を使う設備をつける目標も決まりました"
]
},
{
"start": 1009.697,
"end": 1014.149,
"lines": [
"一方で　世界では",
"海水から真水をつくる方法が広がっています"
]
},
{
"start": 1014.749,
"end": 1019.358,
"lines": [
"世界で動いている淡水化のプラントは",
"約一万五千九百か所"
]
},
{
"start": 1019.958,
"end": 1023.965,
"lines": [
"一日に約九千五百万立方メートルの真水を",
"つくっています"
]
},
{
"start": 1024.565,
"end": 1028.349,
"lines": [
"その四十八パーセントは",
"中東と北アフリカにあります"
]
},
{
"start": 1028.949,
"end": 1036.247,
"lines": [
"その一方で　真水を取り出したあとの濃い塩水が",
"一日に約一億四千二百万立方メートル出ています"
]
},
{
"start": 1036.847,
"end": 1042.115,
"lines": [
"その五十五パーセントは　サウジアラビア",
"アラブ首長国連邦　クウェート"
]
},
{
"start": 1042.115,
"end": 1044.402,
"lines": [
"カタールの四か国から出ています"
]
},
{
"start": 1046.002,
"end": 1050.153,
"lines": [
"地中海の真ん中",
"イタリアの南にある島国マルタでは"
]
},
{
"start": 1050.153,
"end": 1052.138,
"lines": [
"水道の水の約三分の二が"
]
},
{
"start": 1052.138,
"end": 1054.15,
"lines": [
"海水からつくった真水です"
]
},
{
"start": 1054.75,
"end": 1058.968,
"lines": [
"雨や地下水が足りない島が",
"海水に頼る道を選んだ例です"
]
},
{
"start": 1059.568,
"end": 1062.386,
"lines": [
"バミューダは　その両方を組み合わせています"
]
},
{
"start": 1063.986,
"end": 1066.653,
"lines": [
"島の水には　これからの脅威もあります"
]
},
{
"start": 1067.253,
"end": 1073.207,
"lines": [
"国連の気候変動に関する政府間パネル",
"IPCCは　海面の上昇によって"
]
},
{
"start": 1073.207,
"end": 1077.737,
"lines": [
"小さな島の地下水に",
"海水が入り込むことが増えると評価しています"
]
},
{
"start": 1078.337,
"end": 1083.488,
"lines": [
"バミューダ海洋科学研究所の報告は",
"地下の淡水を傷める高い潮位が"
]
},
{
"start": 1083.488,
"end": 1088.133,
"lines": [
"二〇五〇年までに少なくとも",
"十一倍起こりやすくなると見積もっています"
]
},
{
"start": 1088.733,
"end": 1095.082,
"lines": [
"IPCCは　乾燥化によって　多くの小さな島で",
"真水が足りなくなるとも評価しています"
]
},
{
"start": 1095.682,
"end": 1100.274,
"lines": [
"小さな島の淡水は",
"地球で最も脅かされているものの一つです"
]
},
{
"start": 1100.874,
"end": 1107.529,
"lines": [
"海面の上昇で　波が島を越える浸水が増え",
"土と淡水のレンズを傷めるという研究もあります"
]
},
{
"start": 1108.129,
"end": 1114.521,
"lines": [
"バミューダ政府の気候変動の調査では",
"島の建物の六パーセントにあたる二千百三十棟が"
]
},
{
"start": 1114.521,
"end": 1116.423,
"lines": [
"何らかのリスクにさらされます"
]
},
{
"start": 1118.023,
"end": 1120.801,
"lines": [
"ここで　もう一度ジブラルタルを思い出します"
]
},
{
"start": 1121.401,
"end": 1125.128,
"lines": [
"ジブラルタルは",
"海水から真水をつくれるようになると"
]
},
{
"start": 1125.128,
"end": 1127.458,
"lines": [
"雨を集める斜面を取り外しました"
]
},
{
"start": 1128.058,
"end": 1131.696,
"lines": [
"バミューダにも",
"海水から真水をつくるプラントがあります"
]
},
{
"start": 1132.296,
"end": 1137.112,
"lines": [
"それでも　一軒一軒の屋根とタンクは",
"今も島の水の主役です"
]
},
{
"start": 1137.712,
"end": 1141.536,
"lines": [
"二〇一九年",
"イギリスのガーディアン紙の気象のコラムは"
]
},
{
"start": 1141.536,
"end": 1143.678,
"lines": [
"イギリスが水不足を避けるには"
]
},
{
"start": 1143.678,
"end": 1146.137,
"lines": [
"バミューダの屋根に学べると論じました"
]
},
{
"start": 1146.737,
"end": 1150.387,
"lines": [
"雨の多い国にとっても",
"この島の屋根は手本になります"
]
},
{
"start": 1151.987,
"end": 1154.664,
"lines": [
"バミューダには　川も湖もありません"
]
},
{
"start": 1155.264,
"end": 1158.933,
"lines": [
"地下の淡水は薄く",
"くみ上げすぎれば塩水に変わります"
]
},
{
"start": 1159.533,
"end": 1164.312,
"lines": [
"だから島の人々は　雨を屋根で受け止め",
"家の下にためてきました"
]
},
{
"start": 1164.912,
"end": 1169.504,
"lines": [
"足りない分を　海水からつくる水と",
"給水トラックが埋めています"
]
},
{
"start": 1170.104,
"end": 1173.301,
"lines": [
"白い屋根の一つひとつが　この島の水道です"
]
},
{
"start": 1173.901,
"end": 1178.523,
"lines": [
"地図の上の小さな島は",
"雨の一滴を無駄にしない暮らしの見本でした"
]
},
{
"start": 1179.123,
"end": 1182.918,
"lines": [
"次に雨が降ったら",
"自分の家の屋根に落ちる雨の量を"
]
},
{
"start": 1182.918,
"end": 1185.723,
"lines": [
"一平方メートルに一ミリで一リットル"
]
},
{
"start": 1185.723,
"end": 1187.444,
"lines": [
"と計算してみてください"
]
},
{
"start": 1188.044,
"end": 1191.392,
"lines": [
"屋根の上に",
"思っていたより多くの水が降っています"
]
},
{
"start": 1192.992,
"end": 1193.822,
"lines": [
"地球の事情"
]
},
{
"start": 1194.422,
"end": 1197.76,
"lines": [
"次の地図でも",
"その理由を一緒に読み解いていきます"
]
},
{
"start": 1198.36,
"end": 1200.495,
"lines": [
"また　次の地図でお会いしましょう"
]
}
],
