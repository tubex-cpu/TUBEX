[
 {
  "scene": "S01",
  "start": 0.0,
  "end": 5.3,
  "lines": [
   "日本ではもうお馴染みのサーモンですが",
   "どこの海で育ったか　知っていますか？"
  ]
 },
 {
  "scene": "S02",
  "start": 6.8,
  "end": 7.747,
  "lines": [
   "一つはノルウェー"
  ]
 },
 {
  "scene": "S02",
  "start": 8.297,
  "end": 11.319,
  "lines": [
   "では　もう一つの国は　わかりますか？"
  ]
 },
 {
  "scene": "S03",
  "start": 12.819,
  "end": 14.29,
  "lines": [
   "答えは　チリです"
  ]
 },
 {
  "scene": "S03",
  "start": 14.84,
  "end": 16.041,
  "lines": [
   "地球儀を回します"
  ]
 },
 {
  "scene": "S03",
  "start": 16.591,
  "end": 22.588,
  "lines": [
   "チリは　日本のほぼ真裏　南米の西の端に",
   "南北に細長くのびる国です"
  ]
 },
 {
  "scene": "S03",
  "start": 23.138,
  "end": 25.472,
  "lines": [
   "ノルウェーは　ヨーロッパの北の果て"
  ]
 },
 {
  "scene": "S03",
  "start": 26.022,
  "end": 29.373,
  "lines": [
   "日本のサーモンは　地球の両端から届いています"
  ]
 },
 {
  "scene": "S04",
  "start": 30.873,
  "end": 32.742,
  "lines": [
   "では　多いのはどちらか"
  ]
 },
 {
  "scene": "S04",
  "start": 33.292,
  "end": 36.229,
  "lines": [
   "すぐに名前が浮かぶのは　北欧のノルウェーです"
  ]
 },
 {
  "scene": "S04",
  "start": 36.779,
  "end": 39.692,
  "lines": [
   "けれど　量で一番はノルウェーではありません"
  ]
 },
 {
  "scene": "S04",
  "start": 40.242,
  "end": 40.772,
  "lines": [
   "チリです"
  ]
 },
 {
  "scene": "S04",
  "start": 41.322,
  "end": 46.296,
  "lines": [
   "二〇二四年　日本が輸入したサケとマスは",
   "約二十二万トン"
  ]
 },
 {
  "scene": "S04",
  "start": 46.846,
  "end": 49.058,
  "lines": [
   "そのうち約七割がチリから来ました"
  ]
 },
 {
  "scene": "S04",
  "start": 49.608,
  "end": 51.055,
  "lines": [
   "ノルウェーは一割ちょっと"
  ]
 },
 {
  "scene": "S04",
  "start": 51.605,
  "end": 55.36,
  "lines": [
   "チリとノルウェーの二つの国だけで",
   "輸入の八割を占めます"
  ]
 },
 {
  "scene": "S04",
  "start": 55.91,
  "end": 59.558,
  "lines": [
   "この順番は",
   "二〇一五年から一度も変わっていません"
  ]
 },
 {
  "scene": "S05",
  "start": 61.058,
  "end": 63.988,
  "lines": [
   "理由を聞かれたら　多くの人がこう答えます"
  ]
 },
 {
  "scene": "S05",
  "start": 64.538,
  "end": 68.48,
  "lines": [
   "サーモンは冷たい海の魚だから",
   "寒い国から来るのだと"
  ]
 },
 {
  "scene": "S05",
  "start": 69.03,
  "end": 70.174,
  "lines": [
   "半分は当たりです"
  ]
 },
 {
  "scene": "S05",
  "start": 70.724,
  "end": 75.493,
  "lines": [
   "サーモンの海での養殖には",
   "十二度から十五度ほどの冷たい水が要ります"
  ]
 },
 {
  "scene": "S05",
  "start": 76.043,
  "end": 79.0,
  "lines": [
   "しかも",
   "波の立たない入り江でなければいけません"
  ]
 },
 {
  "scene": "S05",
  "start": 79.55,
  "end": 82.301,
  "lines": [
   "日本の海は　夏に水温が上がります"
  ]
 },
 {
  "scene": "S05",
  "start": 82.851,
  "end": 88.555,
  "lines": [
   "だから　一年中冷たい水のある　ノルウェーや",
   "チリのような国で育てられてきました"
  ]
 },
 {
  "scene": "S06",
  "start": 90.055,
  "end": 93.125,
  "lines": [
   "では　日本の海のサケはどうなっているのか"
  ]
 },
 {
  "scene": "S06",
  "start": 93.675,
  "end": 96.745,
  "lines": [
   "日本で獲れるサケは　ほぼ全部がシロザケです"
  ]
 },
 {
  "scene": "S06",
  "start": 97.295,
  "end": 100.172,
  "lines": [
   "そして　そのほぼ全部が北海道で獲れます"
  ]
 },
 {
  "scene": "S06",
  "start": 100.722,
  "end": 106.569,
  "lines": [
   "一九九六年　日本のサケの漁獲は",
   "約二十九万トンありました"
  ]
 },
 {
  "scene": "S06",
  "start": 107.119,
  "end": 110.028,
  "lines": [
   "二〇二四年は　約四万七千トン"
  ]
 },
 {
  "scene": "S06",
  "start": 110.578,
  "end": 113.521,
  "lines": [
   "いちばん多かった年の　六分の一以下です"
  ]
 },
 {
  "scene": "S06",
  "start": 114.071,
  "end": 117.625,
  "lines": [
   "二〇二五年は　さらに減って約一万七千トン"
  ]
 },
 {
  "scene": "S06",
  "start": 118.175,
  "end": 123.683,
  "lines": [
   "いま日本が外国から買うサケとマスは",
   "日本の海で獲れるサケの四倍を超えています"
  ]
 },
 {
  "scene": "S07",
  "start": 125.183,
  "end": 129.054,
  "lines": [
   "ところが　冷たい海の話では",
   "説明できないことがあります"
  ]
 },
 {
  "scene": "S07",
  "start": 129.604,
  "end": 132.074,
  "lines": [
   "チリには　もともとサケがいませんでした"
  ]
 },
 {
  "scene": "S07",
  "start": 132.624,
  "end": 136.87,
  "lines": [
   "半世紀前のチリの川にも海にも",
   "サケは一匹もいなかったのです"
  ]
 },
 {
  "scene": "S07",
  "start": 137.42,
  "end": 142.27,
  "lines": [
   "サケのいなかった国から　いま",
   "日本のサケとマスの七割が来ています"
  ]
 },
 {
  "scene": "S07",
  "start": 142.82,
  "end": 144.966,
  "lines": [
   "この魚は　どこから来たのか"
  ]
 },
 {
  "scene": "S07",
  "start": 145.516,
  "end": 147.452,
  "lines": [
   "運んだのは　日本でした"
  ]
 },
 {
  "scene": "S08",
  "start": 148.952,
  "end": 151.169,
  "lines": [
   "始まりは一九六九年"
  ]
 },
 {
  "scene": "S08",
  "start": 151.719,
  "end": 156.479,
  "lines": [
   "北海道の　国のサケの孵化場に",
   "一人のチリ人が研修に来ました"
  ]
 },
 {
  "scene": "S08",
  "start": 157.029,
  "end": 158.864,
  "lines": [
   "名前はパブロ・アギレラ"
  ]
 },
 {
  "scene": "S08",
  "start": 159.414,
  "end": 162.327,
  "lines": [
   "ここで　日本の水産技術者と出会います"
  ]
 },
 {
  "scene": "S08",
  "start": 162.877,
  "end": 166.41,
  "lines": [
   "この出会いから",
   "チリにサケを運ぶ計画が始まります"
  ]
 },
 {
  "scene": "S09",
  "start": 167.91,
  "end": 170.188,
  "lines": [
   "一九七二年十一月"
  ]
 },
 {
  "scene": "S09",
  "start": 170.738,
  "end": 175.13,
  "lines": [
   "北海道からチリへ",
   "サクラマスの卵十五万粒が送られました"
  ]
 },
 {
  "scene": "S09",
  "start": 175.68,
  "end": 178.64,
  "lines": [
   "行き先は　パタゴニアの町　コジャイケ"
  ]
 },
 {
  "scene": "S09",
  "start": 179.19,
  "end": 184.393,
  "lines": [
   "卵はここで孵り　十二月",
   "チリの歴史で初めてのサクラマスの稚魚が"
  ]
 },
 {
  "scene": "S09",
  "start": 184.393,
  "end": 186.961,
  "lines": [
   "近くのシンプソン川に放されました"
  ]
 },
 {
  "scene": "S10",
  "start": 188.461,
  "end": 192.664,
  "lines": [
   "翌年　チリでクーデターが起き",
   "計画は一度止まります"
  ]
 },
 {
  "scene": "S10",
  "start": 193.214,
  "end": 194.624,
  "lines": [
   "それでも再開しました"
  ]
 },
 {
  "scene": "S10",
  "start": 195.174,
  "end": 196.425,
  "lines": [
   "今度はシロサケです"
  ]
 },
 {
  "scene": "S10",
  "start": 196.975,
  "end": 201.624,
  "lines": [
   "毎年三百万粒の卵が",
   "北海道からコジャイケへ運ばれました"
  ]
 },
 {
  "scene": "S10",
  "start": 202.174,
  "end": 206.433,
  "lines": [
   "一九七四年には　シロサケの放流式が開かれます"
  ]
 },
 {
  "scene": "S10",
  "start": 206.983,
  "end": 214.426,
  "lines": [
   "一九七六年　孵化場が完成し　日本の研究者",
   "白石博士の名前がつけられました"
  ]
 },
 {
  "scene": "S11",
  "start": 215.926,
  "end": 218.901,
  "lines": [
   "サケは　生まれた川に帰ってくる魚です"
  ]
 },
 {
  "scene": "S11",
  "start": 219.451,
  "end": 221.094,
  "lines": [
   "日本の川ではそうでした"
  ]
 },
 {
  "scene": "S11",
  "start": 221.644,
  "end": 226.428,
  "lines": [
   "けれどチリでは　放したシロサケが",
   "生まれた川に戻ってきませんでした"
  ]
 },
 {
  "scene": "S11",
  "start": 226.978,
  "end": 233.3,
  "lines": [
   "一九八六年　計画の終わりが告げられたあとで",
   "一匹のシロサケが見つかります"
  ]
 },
 {
  "scene": "S11",
  "start": 233.85,
  "end": 238.813,
  "lines": [
   "場所は　生まれた川から遠く離れた",
   "プエルト・ナターレスの川"
  ]
 },
 {
  "scene": "S11",
  "start": 239.363,
  "end": 242.532,
  "lines": [
   "その湾の名前は　ウルティマ・エスペランサ"
  ]
 },
 {
  "scene": "S11",
  "start": 243.082,
  "end": 245.177,
  "lines": [
   "スペイン語で　最後の希望です"
  ]
 },
 {
  "scene": "S12",
  "start": 246.677,
  "end": 251.093,
  "lines": [
   "そのころ　川に放すのとは別の道が",
   "すでに始まっていました"
  ]
 },
 {
  "scene": "S12",
  "start": 251.643,
  "end": 252.976,
  "lines": [
   "海で育てる道です"
  ]
 },
 {
  "scene": "S12",
  "start": 253.526,
  "end": 257.952,
  "lines": [
   "日本の企業ニチロは一九七九年　チリで初めて"
  ]
 },
 {
  "scene": "S12",
  "start": 257.952,
  "end": 261.958,
  "lines": [
   "海に浮かべた生簀でサケを",
   "育てる商売を成功させました"
  ]
 },
 {
  "scene": "S12",
  "start": 262.508,
  "end": 268.038,
  "lines": [
   "一九八一年には　日本の協力で",
   "フィヨルドの海に生簀を浮かべ"
  ]
 },
 {
  "scene": "S12",
  "start": 268.038,
  "end": 272.319,
  "lines": [
   "三年から四年かけて親の",
   "サケまで育てる実験が始まります"
  ]
 },
 {
  "scene": "S12",
  "start": 272.869,
  "end": 275.549,
  "lines": [
   "目的は　チリの中で卵をとること"
  ]
 },
 {
  "scene": "S12",
  "start": 276.099,
  "end": 279.95,
  "lines": [
   "この方法は　やがてチリの",
   "養殖会社へ広がっていきました"
  ]
 },
 {
  "scene": "S13",
  "start": 281.45,
  "end": 284.965,
  "lines": [
   "一九八〇年代の半ば　チリの財団が"
  ]
 },
 {
  "scene": "S13",
  "start": 284.965,
  "end": 288.801,
  "lines": [
   "大きな規模でのサケ養殖を",
   "事業にすることに成功します"
  ]
 },
 {
  "scene": "S13",
  "start": 289.351,
  "end": 294.072,
  "lines": [
   "その会社は一九八八年",
   "日本のニッスイが買い取りました"
  ]
 },
 {
  "scene": "S13",
  "start": 294.622,
  "end": 301.296,
  "lines": [
   "一九九三年　チリが輸出したサケのうち",
   "五十六パーセントを買ったのは日本でした"
  ]
 },
 {
  "scene": "S13",
  "start": 301.846,
  "end": 305.981,
  "lines": [
   "サケとマスは　チリで一番の",
   "輸出向けの水産物になりました"
  ]
 },
 {
  "scene": "S14",
  "start": 307.481,
  "end": 312.217,
  "lines": [
   "チリの養殖と加工の拠点は",
   "南部の港町　プエルト・モン"
  ]
 },
 {
  "scene": "S14",
  "start": 312.767,
  "end": 314.451,
  "lines": [
   "南緯四十一・五度です"
  ]
 },
 {
  "scene": "S14",
  "start": 315.001,
  "end": 318.889,
  "lines": [
   "北半球に折り返すと",
   "函館とほとんど同じ緯度になります"
  ]
 },
 {
  "scene": "S14",
  "start": 319.439,
  "end": 324.063,
  "lines": [
   "地球の裏側の　函館の位置で",
   "日本向けのサケが育っています"
  ]
 },
 {
  "scene": "S15",
  "start": 325.563,
  "end": 328.447,
  "lines": [
   "サケのいなかった国は　いまどうなっているのか"
  ]
 },
 {
  "scene": "S15",
  "start": 328.997,
  "end": 335.267,
  "lines": [
   "二〇二四年　チリの養殖場で収穫された魚や貝は",
   "約百四十四万トン"
  ]
 },
 {
  "scene": "S15",
  "start": 335.817,
  "end": 338.134,
  "lines": [
   "そのうち七割が　サケとマスです"
  ]
 },
 {
  "scene": "S15",
  "start": 338.684,
  "end": 344.972,
  "lines": [
   "中身は　アトランティックサーモンが七割近く",
   "ギンザケが四分の一　残りがトラウト"
  ]
 },
 {
  "scene": "S15",
  "start": 345.522,
  "end": 349.964,
  "lines": [
   "サケとマスの半分は",
   "プエルト・モンのあるロス・ラゴス州"
  ]
 },
 {
  "scene": "S15",
  "start": 350.514,
  "end": 353.219,
  "lines": [
   "四割近くが　その南のアイセン州"
  ]
 },
 {
  "scene": "S15",
  "start": 353.769,
  "end": 357.187,
  "lines": [
   "残りの一割が　南の端のマガジャネス州です"
  ]
 },
 {
  "scene": "S15",
  "start": 357.737,
  "end": 364.055,
  "lines": [
   "二〇二五年には　多い月で三百八十六か所の",
   "養殖場が　海で動いていました"
  ]
 },
 {
  "scene": "S16",
  "start": 365.555,
  "end": 369.192,
  "lines": [
   "ただ　この産業は　一度大きく崩れかけています"
  ]
 },
 {
  "scene": "S16",
  "start": 369.742,
  "end": 372.034,
  "lines": [
   "二〇〇七年　チリの養殖場で"
  ]
 },
 {
  "scene": "S16",
  "start": 372.034,
  "end": 376.811,
  "lines": [
   "サケの伝染性貧血を起こすISAウイルスが",
   "初めて見つかりました"
  ]
 },
 {
  "scene": "S16",
  "start": 377.361,
  "end": 383.646,
  "lines": [
   "ウイルスは広がり　アトランティックサーモンの",
   "生産は　二〇〇八年の約三十九万トンから"
  ]
 },
 {
  "scene": "S16",
  "start": 383.646,
  "end": 385.944,
  "lines": [
   "二〇一〇年には約十二万トン"
  ]
 },
 {
  "scene": "S16",
  "start": 386.494,
  "end": 388.688,
  "lines": [
   "二年で三分の一以下に落ちました"
  ]
 },
 {
  "scene": "S16",
  "start": 389.238,
  "end": 392.875,
  "lines": [
   "その後　国が規制を強めて　生産は戻ります"
  ]
 },
 {
  "scene": "S16",
  "start": 393.425,
  "end": 398.252,
  "lines": [
   "この間も　日本向けのトラウトの輸出は",
   "大きくは崩れませんでした"
  ]
 },
 {
  "scene": "S17",
  "start": 399.752,
  "end": 402.521,
  "lines": [
   "二〇一六年には　別の危機が来ます"
  ]
 },
 {
  "scene": "S17",
  "start": 403.071,
  "end": 408.461,
  "lines": [
   "一月　ロス・ラゴス州の海で水温が上がり",
   "雨も風も止まりました"
  ]
 },
 {
  "scene": "S17",
  "start": 409.011,
  "end": 411.33,
  "lines": [
   "強いエルニーニョが　その一因です"
  ]
 },
 {
  "scene": "S17",
  "start": 411.88,
  "end": 418.266,
  "lines": [
   "二月　海で藻が大発生し　生簀のサケが",
   "息ができずに次々と死に始めました"
  ]
 },
 {
  "scene": "S17",
  "start": 418.816,
  "end": 421.183,
  "lines": [
   "被害を受けた養殖場は四十五か所"
  ]
 },
 {
  "scene": "S17",
  "start": 421.733,
  "end": 426.003,
  "lines": [
   "死んだサケは二千五百万匹を超え",
   "重さにして約四万トン"
  ]
 },
 {
  "scene": "S17",
  "start": 426.553,
  "end": 429.658,
  "lines": [
   "その九割以上が",
   "アトランティックサーモンでした"
  ]
 },
 {
  "scene": "S18",
  "start": 431.158,
  "end": 433.751,
  "lines": [
   "ここで　もう一つの思いこみを外します"
  ]
 },
 {
  "scene": "S18",
  "start": 434.301,
  "end": 437.52,
  "lines": [
   "日本人は　昔からサケの刺身を食べてきた"
  ]
 },
 {
  "scene": "S18",
  "start": 438.07,
  "end": 438.746,
  "lines": [
   "違います"
  ]
 },
 {
  "scene": "S18",
  "start": 439.296,
  "end": 444.274,
  "lines": [
   "サケには寄生虫がいると考えられ",
   "日本人はサケを生で食べませんでした"
  ]
 },
 {
  "scene": "S19",
  "start": 445.774,
  "end": 448.748,
  "lines": [
   "その心配には　はっきりした理由があります"
  ]
 },
 {
  "scene": "S19",
  "start": 449.298,
  "end": 455.034,
  "lines": [
   "日本の天然のシロザケ",
   "秋ザケを二十七匹調べると　二十七匹すべてに"
  ]
 },
 {
  "scene": "S19",
  "start": 455.034,
  "end": 457.083,
  "lines": [
   "寄生虫のアニサキスがいました"
  ]
 },
 {
  "scene": "S19",
  "start": 457.633,
  "end": 460.308,
  "lines": [
   "一匹あたり　平均で二十二匹"
  ]
 },
 {
  "scene": "S19",
  "start": 460.858,
  "end": 463.387,
  "lines": [
   "多い魚には　百六十一匹"
  ]
 },
 {
  "scene": "S19",
  "start": 463.937,
  "end": 468.529,
  "lines": [
   "しかもサケやマスでは",
   "アニサキスは内臓より　身の中に多くいます"
  ]
 },
 {
  "scene": "S19",
  "start": 469.079,
  "end": 471.448,
  "lines": [
   "いちばん脂ののった　お腹の身です"
  ]
 },
 {
  "scene": "S19",
  "start": 471.998,
  "end": 475.943,
  "lines": [
   "ところが　ノルウェーの養殖の",
   "アトランティックサーモン八匹と"
  ]
 },
 {
  "scene": "S19",
  "start": 475.943,
  "end": 480.45,
  "lines": [
   "チリの養殖のギンザケ九匹からは",
   "一匹も見つかりませんでした"
  ]
 },
 {
  "scene": "S20",
  "start": 481.95,
  "end": 483.423,
  "lines": [
   "違いは　エサです"
  ]
 },
 {
  "scene": "S20",
  "start": 483.973,
  "end": 487.905,
  "lines": [
   "養殖のサーモンは",
   "寄生虫のいない配合飼料で育ちます"
  ]
 },
 {
  "scene": "S20",
  "start": 488.455,
  "end": 493.552,
  "lines": [
   "この育て方ができて　刺身で食べても",
   "安全なサケとマスが作れるようになりました"
  ]
 },
 {
  "scene": "S20",
  "start": 494.102,
  "end": 497.14,
  "lines": [
   "ヨーロッパで食品の安全を評価する機関も"
  ]
 },
 {
  "scene": "S20",
  "start": 497.14,
  "end": 501.439,
  "lines": [
   "生簀で配合飼料を食べて育った養殖の",
   "アトランティックサーモンでは"
  ]
 },
 {
  "scene": "S20",
  "start": 501.439,
  "end": 504.575,
  "lines": [
   "アニサキスのリスクは無視で",
   "きると結論づけています"
  ]
 },
 {
  "scene": "S20",
  "start": 505.125,
  "end": 509.216,
  "lines": [
   "天然の魚でも",
   "マイナス二十度で丸一日凍らせれば"
  ]
 },
 {
  "scene": "S20",
  "start": 509.216,
  "end": 511.36,
  "lines": [
   "アニサキスはもう人にうつりません"
  ]
 },
 {
  "scene": "S21",
  "start": 512.86,
  "end": 516.807,
  "lines": [
   "生で食べられるサーモンを",
   "日本に持ちこんだのはノルウェーです"
  ]
 },
 {
  "scene": "S21",
  "start": 517.357,
  "end": 522.181,
  "lines": [
   "一九七〇年五月二十八日",
   "ノルウェーの沖に浮かぶヒトラ島"
  ]
 },
 {
  "scene": "S21",
  "start": 522.731,
  "end": 528.57,
  "lines": [
   "オーヴェとシヴェルトのグロントヴェット兄弟が",
   "海に浮かべた網の生簀に　サーモンを入れました"
  ]
 },
 {
  "scene": "S21",
  "start": 529.12,
  "end": 533.039,
  "lines": [
   "これが　養殖に成功した最初の",
   "アトランティックサーモンです"
  ]
 },
 {
  "scene": "S21",
  "start": 533.589,
  "end": 535.693,
  "lines": [
   "翌年　初めての水揚げ"
  ]
 },
 {
  "scene": "S21",
  "start": 536.243,
  "end": 542.829,
  "lines": [
   "一九七〇年に五百トンだったノルウェーの",
   "養殖サーモンは　一九八〇年に八千トン"
  ]
 },
 {
  "scene": "S21",
  "start": 542.829,
  "end": 546.141,
  "lines": [
   "一九九〇年には十七万トンになります"
  ]
 },
 {
  "scene": "S22",
  "start": 547.641,
  "end": 553.081,
  "lines": [
   "一九八〇年代　日本では",
   "すしの人気にマグロが追いつかなくなります"
  ]
 },
 {
  "scene": "S22",
  "start": 553.631,
  "end": 555.811,
  "lines": [
   "ノルウェーは　そこに目をつけました"
  ]
 },
 {
  "scene": "S23",
  "start": 557.311,
  "end": 561.742,
  "lines": [
   "一九八五年",
   "ノルウェーの代表団が東京に来ました"
  ]
 },
 {
  "scene": "S23",
  "start": 562.292,
  "end": 565.63,
  "lines": [
   "率いたのは　元漁業大臣のトール・リスタウ"
  ]
 },
 {
  "scene": "S23",
  "start": 566.18,
  "end": 569.86,
  "lines": [
   "目的は　生のサーモンを",
   "すしのネタにすることです"
  ]
 },
 {
  "scene": "S23",
  "start": 570.41,
  "end": 576.691,
  "lines": [
   "ノルウェー大使館の夕食会で　輸入業者や",
   "飲食店で　サーモンのすしを食べてもらいました"
  ]
 },
 {
  "scene": "S24",
  "start": 578.191,
  "end": 579.598,
  "lines": [
   "すぐには売れませんでした"
  ]
 },
 {
  "scene": "S24",
  "start": 580.148,
  "end": 583.895,
  "lines": [
   "ノルウェーのサーモンは",
   "築地の市場で最初は嫌われました"
  ]
 },
 {
  "scene": "S24",
  "start": 584.445,
  "end": 587.421,
  "lines": [
   "それでもノルウェーは",
   "十年かけて売り込みを続けます"
  ]
 },
 {
  "scene": "S24",
  "start": 587.971,
  "end": 592.988,
  "lines": [
   "一九八〇年　ノルウェーから日本へ",
   "のサーモンは　たったの二トン"
  ]
 },
 {
  "scene": "S24",
  "start": 593.538,
  "end": 597.106,
  "lines": [
   "二十年後には　一年で四万五千トンを超えました"
  ]
 },
 {
  "scene": "S24",
  "start": 597.656,
  "end": 602.764,
  "lines": [
   "ノルウェーのサーモンが本当に勢いづいたのは",
   "一九八〇年代の終わり"
  ]
 },
 {
  "scene": "S24",
  "start": 603.314,
  "end": 607.022,
  "lines": [
   "日本人が",
   "生のノルウェーサーモンを食べ始めてからです"
  ]
 },
 {
  "scene": "S24",
  "start": 607.572,
  "end": 614.077,
  "lines": [
   "二〇二〇年の調査では　サーモンは九年続けて",
   "回転寿司で一番人気のネタになりました"
  ]
 },
 {
  "scene": "S25",
  "start": 615.577,
  "end": 619.97,
  "lines": [
   "では　いまのノルウェーにとって",
   "日本は一番のお客さんなのか"
  ]
 },
 {
  "scene": "S25",
  "start": 620.52,
  "end": 625.323,
  "lines": [
   "二〇二四年　ノルウェーが",
   "輸出したサーモンは約百二十六万トン"
  ]
 },
 {
  "scene": "S25",
  "start": 625.873,
  "end": 630.456,
  "lines": [
   "金額は過去最高で",
   "ノルウェーの水産物の輸出の七割を占めます"
  ]
 },
 {
  "scene": "S25",
  "start": 631.006,
  "end": 635.195,
  "lines": [
   "ところが　いちばん多く買っている国は",
   "日本ではありません"
  ]
 },
 {
  "scene": "S25",
  "start": 635.745,
  "end": 638.445,
  "lines": [
   "ポーランド　アメリカ　フランスです"
  ]
 },
 {
  "scene": "S25",
  "start": 638.995,
  "end": 643.312,
  "lines": [
   "日本で生で食べ始めたサーモンは",
   "いまや世界中に届いています"
  ]
 },
 {
  "scene": "S26",
  "start": 644.812,
  "end": 648.615,
  "lines": [
   "ここで　もう一度　回転寿司の産地表に戻ります"
  ]
 },
 {
  "scene": "S26",
  "start": 649.165,
  "end": 653.281,
  "lines": [
   "くら寿司のサーモンの欄には",
   "三つの魚の名前が並んでいました"
  ]
 },
 {
  "scene": "S26",
  "start": 653.831,
  "end": 657.412,
  "lines": [
   "アトランティックサーモン",
   "サーモントラウト　ギンザケ"
  ]
 },
 {
  "scene": "S26",
  "start": 657.962,
  "end": 660.035,
  "lines": [
   "この三つは　別の魚です"
  ]
 },
 {
  "scene": "S26",
  "start": 660.585,
  "end": 665.273,
  "lines": [
   "アトランティックサーモンの",
   "日本の標準の名前は　タイセイヨウサケ"
  ]
 },
 {
  "scene": "S26",
  "start": 665.823,
  "end": 668.878,
  "lines": [
   "サーモントラウトは　海で育てたニジマスです"
  ]
 },
 {
  "scene": "S26",
  "start": 669.428,
  "end": 670.353,
  "lines": [
   "そしてギンザケ"
  ]
 },
 {
  "scene": "S26",
  "start": 670.903,
  "end": 674.955,
  "lines": [
   "どれもサーモンとして　私たちの前に出てきます"
  ]
 },
 {
  "scene": "S27",
  "start": 676.455,
  "end": 680.118,
  "lines": [
   "三つの魚は　来る国も　届き方も違います"
  ]
 },
 {
  "scene": "S27",
  "start": 680.668,
  "end": 684.301,
  "lines": [
   "チリから来るサケとマスは",
   "九十七パーセントが冷凍"
  ]
 },
 {
  "scene": "S27",
  "start": 684.851,
  "end": 686.908,
  "lines": [
   "中身の三分の二はギンザケです"
  ]
 },
 {
  "scene": "S27",
  "start": 687.458,
  "end": 692.597,
  "lines": [
   "日本が輸入するサケとマスの四十五パーセントは",
   "チリの冷凍のギンザケです"
  ]
 },
 {
  "scene": "S27",
  "start": 693.147,
  "end": 698.606,
  "lines": [
   "一方　ノルウェーから来るサケとマスは",
   "九割近くが冷凍していない生のまま"
  ]
 },
 {
  "scene": "S27",
  "start": 699.156,
  "end": 703.526,
  "lines": [
   "日本に凍らずに届くサケとマスの四分の三は",
   "ノルウェー産です"
  ]
 },
 {
  "scene": "S27",
  "start": 704.076,
  "end": 708.563,
  "lines": [
   "生のまま丸ごと届くアトランティックサーモンで",
   "は　ノルウェーが三分の二"
  ]
 },
 {
  "scene": "S27",
  "start": 709.113,
  "end": 711.019,
  "lines": [
   "チリは一パーセントしかありません"
  ]
 },
 {
  "scene": "S27",
  "start": 711.569,
  "end": 715.752,
  "lines": [
   "一キロあたりの値段は",
   "ノルウェー産がチリ産の約一・八倍"
  ]
 },
 {
  "scene": "S27",
  "start": 716.302,
  "end": 718.444,
  "lines": [
   "量のチリ　生のノルウェーです"
  ]
 },
 {
  "scene": "S28",
  "start": 719.944,
  "end": 723.054,
  "lines": [
   "いま　この地図に三つ目の線が太くなっています"
  ]
 },
 {
  "scene": "S28",
  "start": 723.604,
  "end": 724.303,
  "lines": [
   "トルコです"
  ]
 },
 {
  "scene": "S28",
  "start": 724.853,
  "end": 729.219,
  "lines": [
   "トルコからの輸入は",
   "二〇一七年の約四百八十トンから"
  ]
 },
 {
  "scene": "S28",
  "start": 729.219,
  "end": 731.97,
  "lines": [
   "二〇二四年には約六千二百トン"
  ]
 },
 {
  "scene": "S28",
  "start": 732.52,
  "end": 734.298,
  "lines": [
   "七年で約十三倍です"
  ]
 },
 {
  "scene": "S28",
  "start": 734.848,
  "end": 738.007,
  "lines": [
   "トルコから来るのは",
   "ほとんどが冷凍のトラウトです"
  ]
 },
 {
  "scene": "S28",
  "start": 738.557,
  "end": 743.827,
  "lines": [
   "スシローのサーモンの産地表では",
   "トルコの名前が　チリより先に書かれています"
  ]
 },
 {
  "scene": "S29",
  "start": 745.327,
  "end": 747.672,
  "lines": [
   "日本の海で育てるサーモンもあります"
  ]
 },
 {
  "scene": "S29",
  "start": 748.222,
  "end": 751.115,
  "lines": [
   "宮城県南三陸町の　志津川湾"
  ]
 },
 {
  "scene": "S29",
  "start": 751.665,
  "end": 757.468,
  "lines": [
   "一九七〇年代　ここで日本で初めて",
   "ギンザケの養殖が成功しました"
  ]
 },
 {
  "scene": "S29",
  "start": 758.018,
  "end": 761.475,
  "lines": [
   "卵から稚魚までは　山の淡水の池で育てます"
  ]
 },
 {
  "scene": "S29",
  "start": 762.025,
  "end": 766.402,
  "lines": [
   "十一月　約百五十グラムに",
   "なった稚魚を　海の生簀へ"
  ]
 },
 {
  "scene": "S29",
  "start": 766.952,
  "end": 769.615,
  "lines": [
   "水揚げのころには　約二キロになります"
  ]
 },
 {
  "scene": "S29",
  "start": 770.165,
  "end": 775.999,
  "lines": [
   "二〇一一年　東日本大震災の津波で",
   "湾の生簀も船も流されました"
  ]
 },
 {
  "scene": "S29",
  "start": 776.549,
  "end": 781.048,
  "lines": [
   "それでも　山の池で育てていた稚魚は",
   "七割ほどが無事でした"
  ]
 },
 {
  "scene": "S29",
  "start": 781.598,
  "end": 784.567,
  "lines": [
   "半年後　その稚魚がふたたび海に入ります"
  ]
 },
 {
  "scene": "S29",
  "start": 785.117,
  "end": 789.713,
  "lines": [
   "宮城のギンザケは　二〇一七年",
   "みやぎサーモンとして"
  ]
 },
 {
  "scene": "S29",
  "start": 789.713,
  "end": 793.432,
  "lines": [
   "宮城県で初めての地理的表示に登録されました"
  ]
 },
 {
  "scene": "S30",
  "start": 794.932,
  "end": 799.39,
  "lines": [
   "二〇二四年",
   "日本の養殖ギンザケは約一万七千トン"
  ]
 },
 {
  "scene": "S30",
  "start": 799.94,
  "end": 802.584,
  "lines": [
   "その八割近くが宮城県で育ちました"
  ]
 },
 {
  "scene": "S30",
  "start": 803.134,
  "end": 806.235,
  "lines": [
   "二〇二五年は約二万一千トンに増えています"
  ]
 },
 {
  "scene": "S30",
  "start": 806.785,
  "end": 811.244,
  "lines": [
   "それでも　同じ二〇二四年に",
   "チリから届いた冷凍のギンザケは"
  ]
 },
 {
  "scene": "S30",
  "start": 811.244,
  "end": 812.855,
  "lines": [
   "約九万九千トン"
  ]
 },
 {
  "scene": "S30",
  "start": 813.405,
  "end": 814.984,
  "lines": [
   "国産のおよそ六倍です"
  ]
 },
 {
  "scene": "S31",
  "start": 816.484,
  "end": 820.573,
  "lines": [
   "そして　地球の両端から届くサーモンは",
   "高くなっています"
  ]
 },
 {
  "scene": "S31",
  "start": 821.123,
  "end": 827.523,
  "lines": [
   "日本が輸入するサケとマスの一キロの値段は",
   "二〇一五年の約七百七十円から"
  ]
 },
 {
  "scene": "S31",
  "start": 827.523,
  "end": 831.025,
  "lines": [
   "二〇二四年には約千二百八十円"
  ]
 },
 {
  "scene": "S31",
  "start": 831.575,
  "end": 833.421,
  "lines": [
   "九年で約一・七倍です"
  ]
 },
 {
  "scene": "S31",
  "start": 833.971,
  "end": 840.222,
  "lines": [
   "ノルウェー産は　約千四十円から約二千百円へ",
   "二倍になりました"
  ]
 },
 {
  "scene": "S31",
  "start": 840.772,
  "end": 843.815,
  "lines": [
   "いちばん大きく跳ねたのは　二〇二二年です"
  ]
 },
 {
  "scene": "S31",
  "start": 844.365,
  "end": 848.77,
  "lines": [
   "買う量は一割ちょっと減ったのに",
   "払うお金は一・五倍になりました"
  ]
 },
 {
  "scene": "S32",
  "start": 850.27,
  "end": 852.715,
  "lines": [
   "地図に　二本の矢印を描きます"
  ]
 },
 {
  "scene": "S32",
  "start": 853.265,
  "end": 855.294,
  "lines": [
   "一本は　日本からチリへ"
  ]
 },
 {
  "scene": "S32",
  "start": 855.844,
  "end": 858.226,
  "lines": [
   "日本が運んだのは　魚でした"
  ]
 },
 {
  "scene": "S32",
  "start": 858.776,
  "end": 861.344,
  "lines": [
   "もう一本は　ノルウェーから日本へ"
  ]
 },
 {
  "scene": "S32",
  "start": 861.894,
  "end": 864.611,
  "lines": [
   "ノルウェーが運んできたのは　食べ方でした"
  ]
 },
 {
  "scene": "S32",
  "start": 865.161,
  "end": 870.225,
  "lines": [
   "向きが逆の二本の矢印が交わったところに",
   "回転寿司のサーモンがあります"
  ]
 },
 {
  "scene": "S33",
  "start": 871.725,
  "end": 875.156,
  "lines": [
   "回転寿司のサーモンが　地球の両端から来る理由"
  ]
 },
 {
  "scene": "S33",
  "start": 875.706,
  "end": 878.344,
  "lines": [
   "冷たい海が要るから　だけではありません"
  ]
