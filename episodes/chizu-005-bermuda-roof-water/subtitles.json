[
 {
  "scene": "S01",
  "start": 0.0,
  "end": 2.368,
  "lines": [
   "大西洋に浮かぶ島　バミューダ"
  ]
 },
 {
  "scene": "S01",
  "start": 2.718,
  "end": 6.663,
  "lines": [
   "この島の家々の屋根は",
   "白い階段のような形をしています"
  ]
 },
 {
  "scene": "S01",
  "start": 7.013,
  "end": 9.856,
  "lines": [
   "この屋根の下に　家族の飲み水があります"
  ]
 },
 {
  "scene": "S01",
  "start": 10.206,
  "end": 13.813,
  "lines": [
   "では　雨が降らないとき　島の人はどうするのか"
  ]
 },
 {
  "scene": "S01",
  "start": 14.163,
  "end": 16.541,
  "lines": [
   "水の行き先を　地図で追いかけます"
  ]
 },
 {
  "scene": "S02",
  "start": 17.441,
  "end": 22.3,
  "lines": [
   "バミューダは　北アメリカのハッテラス岬から",
   "東南東へおよそ千キロ"
  ]
 },
 {
  "scene": "S02",
  "start": 22.65,
  "end": 26.844,
  "lines": [
   "面積は約五十三平方キロメートルの小さな島です"
  ]
 },
 {
  "scene": "S02",
  "start": 27.194,
  "end": 32.486,
  "lines": [
   "二〇一六年の国勢調査では",
   "約六万四千人が暮らしています"
  ]
 },
 {
  "scene": "S03",
  "start": 33.386,
  "end": 37.027,
  "lines": [
   "この島には　川も　淡水の湖もありません"
  ]
 },
 {
  "scene": "S03",
  "start": 37.377,
  "end": 40.406,
  "lines": [
   "池はありますが　その水は塩を含んでいます"
  ]
 },
 {
  "scene": "S04",
  "start": 41.306,
  "end": 44.513,
  "lines": [
   "降った雨は　島をつくる石灰岩にしみ込みます"
  ]
 },
 {
  "scene": "S04",
  "start": 44.863,
  "end": 49.731,
  "lines": [
   "そして地下で　重い海水の上に",
   "薄い淡水の層となって浮かびます"
  ]
 },
 {
  "scene": "S04",
  "start": 50.081,
  "end": 52.899,
  "lines": [
   "政府は　この地下の水もくみ上げています"
  ]
 },
 {
  "scene": "S04",
  "start": 53.249,
  "end": 57.909,
  "lines": [
   "そして島の人々は　もう一つの水源を",
   "自分の家につくりました"
  ]
 },
 {
  "scene": "S05",
  "start": 58.809,
  "end": 60.204,
  "lines": [
   "それが　屋根です"
  ]
 },
 {
  "scene": "S05",
  "start": 60.554,
  "end": 63.904,
  "lines": [
   "屋根は　地元の石灰岩の板を重ねてつくります"
  ]
 },
 {
  "scene": "S05",
  "start": 64.254,
  "end": 68.833,
  "lines": [
   "階段のような段が雨の勢いを弱め",
   "雨水を雨どいへ導きます"
  ]
 },
 {
  "scene": "S05",
  "start": 69.183,
  "end": 71.365,
  "lines": [
   "そして屋根は　白く塗られています"
  ]
 },
 {
  "scene": "S06",
  "start": 72.265,
  "end": 75.275,
  "lines": [
   "雨どいの先にあるのは　家の下のタンクです"
  ]
 },
 {
  "scene": "S06",
  "start": 75.625,
  "end": 79.45,
  "lines": [
   "屋根で集めた雨は",
   "ここにためられ　家の水になります"
  ]
 },
 {
  "scene": "S06",
  "start": 79.8,
  "end": 85.116,
  "lines": [
   "昔は　家の横の石造りの小屋にタンクを置き",
   "石の雨どいでつないでいました"
  ]
 },
 {
  "scene": "S06",
  "start": 85.466,
  "end": 90.09,
  "lines": [
   "一八〇九年に描かれた絵にも",
   "水をためる施設が描かれています"
  ]
 },
 {
  "scene": "S07",
  "start": 90.99,
  "end": 94.285,
  "lines": [
   "この仕組みは　一軒一軒の工夫ではありません"
  ]
 },
 {
  "scene": "S07",
  "start": 94.635,
  "end": 98.577,
  "lines": [
   "法律で　家に雨水をためるタンクを",
   "持つことが決まっています"
  ]
 },
 {
  "scene": "S07",
  "start": 98.927,
  "end": 102.057,
  "lines": [
   "屋根が広い家ほど　大きなタンクが必要です"
  ]
 },
 {
  "scene": "S08",
  "start": 102.957,
  "end": 106.925,
  "lines": [
   "ただ　雨が少ない夏には",
   "タンクの水が足りなくなります"
  ]
 },
 {
  "scene": "S08",
  "start": 107.275,
  "end": 110.613,
  "lines": [
   "そのとき住民は　給水トラックから水を買います"
  ]
 },
 {
  "scene": "S08",
  "start": 110.963,
  "end": 113.505,
  "lines": [
   "二〇一八年の政府の説明では"
  ]
 },
 {
  "scene": "S08",
  "start": 113.505,
  "end": 118.394,
  "lines": [
   "日照りのときにトラックの水に頼る住民は",
   "約四万人です"
  ]
 },
 {
  "scene": "S08",
  "start": 118.744,
  "end": 122.993,
  "lines": [
   "給水トラックの業者は",
   "タンクに常に一〜二週間分の水を"
  ]
 },
 {
  "scene": "S08",
  "start": 122.993,
  "end": 124.693,
  "lines": [
   "残すよう勧めています"
  ]
 },
 {
  "scene": "S09",
  "start": 125.593,
  "end": 132.103,
  "lines": [
   "トラックの水の元の一つは　海水を淡水に変える",
   "タインズ・ベイの逆浸透プラントです"
  ]
 },
 {
  "scene": "S09",
  "start": 132.453,
  "end": 133.977,
  "lines": [
   "政府の主な水源です"
  ]
 },
 {
  "scene": "S09",
  "start": 134.327,
  "end": 138.76,
  "lines": [
   "二〇二五年二月",
   "このプラントの取水設備が大きく故障し"
  ]
 },
 {
  "scene": "S09",
  "start": 138.76,
  "end": 141.848,
  "lines": [
   "給水トラック用の東部の出口が閉まりました"
  ]
 },
 {
  "scene": "S09",
  "start": 142.198,
  "end": 147.714,
  "lines": [
   "二〇二六年五月には",
   "東部に二十四時間使える新しい出口が開きました"
  ]
 },
 {
  "scene": "S10",
  "start": 148.614,
  "end": 154.068,
  "lines": [
   "二〇二五年の日照りでも　政府は住民に",
   "家のタンクの残りを確かめ"
  ]
 },
 {
  "scene": "S10",
  "start": 154.068,
  "end": 156.614,
  "lines": [
   "早めに節水するよう呼びかけました"
  ]
 },
 {
  "scene": "S11",
  "start": 157.514,
  "end": 160.191,
  "lines": [
   "バミューダには　川も湖もありません"
  ]
 },
 {
  "scene": "S11",
  "start": 160.541,
  "end": 165.977,
  "lines": [
   "そのかわり　一軒一軒の屋根とタンクが",
   "島の水道の役目を果たしています"
  ]
 },
 {
  "scene": "S11",
  "start": 166.327,
  "end": 170.918,
  "lines": [
   "足りない分を　海水からつくる水と",
   "給水トラックが埋めています"
  ]
 },
 {
  "scene": "S11",
  "start": 171.268,
  "end": 174.314,
  "lines": [
   "白い屋根の一つひとつが　雨の受け皿です"
  ]
 },
 {
  "scene": "S12",
  "start": 175.214,
  "end": 176.044,
  "lines": [
   "地球の事情"
  ]
 },
 {
  "scene": "S12",
  "start": 176.394,
  "end": 179.733,
  "lines": [
   "次の地図でも",
   "その理由を一緒に読み解いていきます"
  ]
 },
 {
  "scene": "S12",
  "start": 180.083,
  "end": 182.217,
  "lines": [
   "また　次の地図でお会いしましょう"
  ]
 }
]