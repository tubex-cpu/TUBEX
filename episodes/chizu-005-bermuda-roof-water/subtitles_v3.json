 },
 {
  "scene": "S40",
  "start": 1185.723,
  "end": 1187.444,
  "lines": [
   "と計算してみてください"
  ]
 },
 {
  "scene": "S40",
  "start": 1188.044,
  "end": 1191.392,
  "lines": [
   "屋根の上に",
   "思っていたより多くの水が降っています"
  ]
 },
 {
  "scene": "S41",
  "start": 1192.992,
  "end": 1193.822,
  "lines": [
   "地球の事情"
  ]
 },
 {
  "scene": "S41",
  "start": 1194.422,
  "end": 1197.76,
  "lines": [
   "次の地図でも",
   "その理由を一緒に読み解いていきます"
  ]
 },
 {
  "scene": "S41",
  "start": 1198.36,
  "end": 1200.495,
  "lines": [
   "また　次の地図でお会いしましょう"
  ]
 }
]