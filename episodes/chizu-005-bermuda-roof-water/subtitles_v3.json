   "アラブ首長国連邦　クウェート"
  ]
 },
 {
  "scene": "S36",
  "start": 1042.115,
  "end": 1044.402,
  "lines": [
   "カタールの四か国から出ています"
  ]
 },
 {
  "scene": "S37",
  "start": 1046.002,
  "end": 1050.153,
  "lines": [
   "地中海の真ん中",
   "イタリアの南にある島国マルタでは"
  ]
 },
 {
  "scene": "S37",
  "start": 1050.153,
  "end": 1052.138,
  "lines": [
   "水道の水の約三分の二が"
  ]
 },
 {
  "scene": "S37",
  "start": 1052.138,
  "end": 1054.15,
  "lines": [
   "海水からつくった真水です"
  ]
 },
 {
  "scene": "S37",
  "start": 1054.75,
  "end": 1058.968,
  "lines": [
   "雨や地下水が足りない島が",
   "海水に頼る道を選んだ例です"
