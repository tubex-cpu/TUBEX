 },
 {
  "scene": "S35",
  "start": 976.191,
  "end": 978.879,
  "lines": [
   "ビクトリア州では二十九パーセントです"
  ]
 },
 {
  "scene": "S35",
  "start": 979.479,
  "end": 980.929,
  "lines": [
   "日本にも例があります"
  ]
 },
 {
  "scene": "S35",
  "start": 981.529,
  "end": 989.021,
  "lines": [
   "一九八五年に完成した東京の両国国技館は",
