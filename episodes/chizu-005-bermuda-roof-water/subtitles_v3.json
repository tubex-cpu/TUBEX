 },
 {
  "scene": "S37",
  "start": 1059.568,
  "end": 1062.386,
  "lines": [
   "バミューダは　その両方を組み合わせています"
  ]
 },
 {
  "scene": "S38",
  "start": 1063.986,
  "end": 1066.653,
  "lines": [
   "島の水には　これからの脅威もあります"
  ]
 },
 {
  "scene": "S38",
  "start": 1067.253,
  "end": 1073.207,
  "lines": [
