 },
 {
  "scene": "S38",
  "start": 1073.207,
  "end": 1077.737,
  "lines": [
   "小さな島の地下水に",
   "海水が入り込むことが増えると評価しています"
  ]
 },
 {
  "scene": "S38",
  "start": 1078.337,
  "end": 1083.488,
  "lines": [
   "バミューダ海洋科学研究所の報告は",
