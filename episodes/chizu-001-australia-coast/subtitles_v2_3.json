[
 {
  "scene": "S01",
  "start": 0.0,
  "end": 3.005,
  "lines": [
   "オーストラリアの地図に",
   "大きな都市を置いてみます"
  ]
 },
 {
  "scene": "S01",
  "start": 3.355,
  "end": 7.112,
  "lines": [
   "シドニー　メルボルン　ブリスベン　アデレード"
  ]
 },
 {
  "scene": "S01",
  "start": 7.462,
  "end": 9.006,
  "lines": [
   "そして　西のパース"
  ]
 },
 {
  "scene": "S01",
  "start": 9.356,
  "end": 12.503,
  "lines": [
   "五つの大都市は　どれも海のそばに並んでいます"
  ]
 },
 {
  "scene": "S01",
  "start": 12.853,
  "end": 15.493,
  "lines": [
   "大陸の真ん中には　一つもありません"
  ]
 },
 {
  "scene": "S01",
  "start": 15.843,
  "end": 21.29,
  "lines": [
   "日本のおよそ二十倍の広さがある大陸で",
   "人はなぜ　縁にばかり集まったのか"
  ]
 },
 {
  "scene": "S02",
  "start": 22.19,
  "end": 25.131,
  "lines": [
   "まず浮かぶ答えは　内陸が砂漠だから"
  ]
 },
 {
  "scene": "S02",
  "start": 25.481,
  "end": 27.934,
  "lines": [
   "乾燥は　たしかに大きな理由です"
  ]
 },
 {
  "scene": "S02",
  "start": 28.284,
  "end": 33.016,
  "lines": [
   "ただ　それだけなら",
   "海沿いならどこでも同じように街が育つはずです"
  ]
 },
 {
  "scene": "S02",
  "start": 33.366,
  "end": 37.44,
  "lines": [
   "しかも　首都のキャンベラは",
   "海から離れた内陸にあります"
  ]
 },
 {
  "scene": "S02",
  "start": 37.79,
  "end": 40.872,
  "lines": [
   "今回は　水　港　仕事"
  ]
 },
 {
  "scene": "S02",
  "start": 41.222,
  "end": 44.866,
  "lines": [
   "三つの理由を重ねて",
   "この地図の偏りを解いていきます"
  ]
 },
 {
  "scene": "S03",
  "start": 45.766,
  "end": 46.95,
  "lines": [
   "数字で確かめます"
  ]
 },
 {
  "scene": "S03",
  "start": 47.3,
  "end": 52.825,
  "lines": [
   "オーストラリア統計局の推計で",
   "二〇二五年六月末のシドニー都市圏は"
  ]
 },
 {
  "scene": "S03",
  "start": 52.825,
  "end": 54.754,
  "lines": [
   "約五百六十四万人"
  ]
 },
 {
  "scene": "S03",
  "start": 55.104,
  "end": 58.685,
  "lines": [
   "メルボルン都市圏は　約五百四十四万人です"
  ]
 },
 {
  "scene": "S03",
  "start": 59.035,
  "end": 63.856,
  "lines": [
   "ここでいう都市圏は",
   "市役所が受け持つ狭い市ではありません"
  ]
 },
 {
  "scene": "S03",
  "start": 64.206,
  "end": 67.78,
  "lines": [
   "周りの住宅地まで含めた　広い統計の区域です"
  ]
 },
 {
  "scene": "S03",
  "start": 68.13,
  "end": 71.541,
  "lines": [
   "シドニーの場合",
   "北のセントラルコーストまで含みます"
  ]
 },
 {
  "scene": "S04",
  "start": 72.441,
  "end": 75.83,
  "lines": [
   "ブリスベン都市圏は　約二百八十三万人"
  ]
 },
 {
  "scene": "S04",
  "start": 76.18,
  "end": 78.682,
  "lines": [
   "パースは　約二百四十五万人"
  ]
 },
 {
  "scene": "S04",
  "start": 79.032,
  "end": 81.747,
  "lines": [
   "アデレードは　約百四十九万人"
  ]
 },
 {
  "scene": "S04",
  "start": 82.097,
  "end": 83.96,
  "lines": [
   "東の海岸だけではありません"
  ]
 },
 {
  "scene": "S04",
  "start": 84.31,
  "end": 88.032,
  "lines": [
   "南の湾にも　西の海辺にも　大都市があります"
  ]
 },
 {
  "scene": "S04",
  "start": 88.382,
  "end": 92.04,
  "lines": [
   "五つの都市に共通するのは",
   "海に面していることです"
  ]
 },
 {
  "scene": "S05",
  "start": 92.94,
  "end": 97.115,
  "lines": [
   "街をつくるのに必要なのは",
   "建物を建てる土地だけではありません"
  ]
 },
 {
  "scene": "S05",
  "start": 97.465,
  "end": 98.512,
  "lines": [
   "毎日飲む水"
  ]
 },
 {
  "scene": "S05",
  "start": 98.862,
  "end": 100.547,
  "lines": [
   "畑や牧場をうるおす水"
  ]
 },
 {
  "scene": "S05",
  "start": 100.897,
  "end": 102.177,
  "lines": [
   "工場を動かす水"
  ]
 },
 {
  "scene": "S05",
  "start": 102.527,
  "end": 105.445,
  "lines": [
   "人が増えるほど　必要な水も増えていきます"
  ]
 },
 {
  "scene": "S05",
  "start": 105.795,
  "end": 110.703,
  "lines": [
   "広い土地があることと",
   "大勢の暮らしを支えられることは　別の話です"
  ]
 },
 {
  "scene": "S05",
  "start": 111.053,
  "end": 115.213,
  "lines": [
   "では　オーストラリアの内陸は",
   "なぜこれほど乾いているのか"
  ]
 },
 {
  "scene": "S06",
  "start": 116.113,
  "end": 118.126,
  "lines": [
   "答えは　空の上にあります"
  ]
 },
 {
  "scene": "S06",
  "start": 118.476,
  "end": 124.401,
  "lines": [
   "赤道の近くで温められて上昇した空気は",
   "上空を流れ　やがて下へ降りてきます"
  ]
 },
 {
  "scene": "S06",
  "start": 124.751,
  "end": 128.161,
  "lines": [
   "降りてくる空気は乾いていて",
   "高気圧をつくります"
  ]
 },
 {
  "scene": "S06",
  "start": 128.511,
  "end": 132.338,
  "lines": [
   "高気圧の下では",
   "雲ができにくく　雨が降りにくい"
  ]
 },
 {
  "scene": "S06",
  "start": 132.688,
  "end": 138.848,
  "lines": [
   "オーストラリアの中央部は　この高気圧の帯",
   "亜熱帯高圧帯の影響を強く受けています"
  ]
 },
 {
  "scene": "S07",
  "start": 139.748,
  "end": 143.31,
  "lines": [
   "ただし",
   "大陸全体が同じ気候なわけではありません"
  ]
 },
 {
  "scene": "S07",
  "start": 143.66,
  "end": 146.702,
  "lines": [
   "北部は　雨季と乾季がはっきり分かれる熱帯"
  ]
 },
 {
  "scene": "S07",
  "start": 147.052,
  "end": 149.768,
  "lines": [
   "南部には　四季のある温帯が広がります"
  ]
 },
 {
  "scene": "S07",
  "start": 150.118,
  "end": 155.827,
  "lines": [
   "東の海岸では　海から来る湿った空気と山地が",
   "雨の降り方を左右します"
  ]
 },
 {
  "scene": "S07",
  "start": 156.177,
  "end": 159.228,
  "lines": [
   "雨と気温の条件が　場所ごとに大きく違う"
  ]
 },
 {
  "scene": "S07",
  "start": 159.578,
  "end": 162.82,
  "lines": [
   "都市の分布を読むときは",
   "この違いが土台になります"
  ]
 },
 {
  "scene": "S08",
  "start": 163.72,
  "end": 168.875,
  "lines": [
   "ただ　気候だけでは　どの海岸に",
   "大都市ができたのかまでは説明できません"
  ]
 },
 {
  "scene": "S08",
  "start": 169.225,
  "end": 170.43,
  "lines": [
   "ここからは歴史です"
  ]
 },
 {
  "scene": "S08",
  "start": 170.78,
  "end": 175.091,
  "lines": [
   "十八世紀の終わり",
   "イギリスから海を渡ってきた船団にとって"
  ]
 },
 {
  "scene": "S08",
  "start": 175.091,
  "end": 177.154,
  "lines": [
   "まず必要なものは二つでした"
  ]
 },
 {
  "scene": "S08",
  "start": 177.504,
  "end": 179.071,
  "lines": [
   "船を安全に泊められる湾"
  ]
 },
 {
  "scene": "S08",
  "start": 179.421,
  "end": 181.59,
  "lines": [
   "そして　すぐに使える真水です"
  ]
 },
 {
  "scene": "S09",
  "start": 182.49,
  "end": 184.611,
  "lines": [
   "一七八八年一月"
  ]
 },
 {
  "scene": "S09",
  "start": 184.961,
  "end": 189.523,
  "lines": [
   "イギリスの第一船団は",
   "最初の計画地だったボタニー湾に着きました"
  ]
 },
 {
  "scene": "S09",
  "start": 189.873,
  "end": 193.622,
  "lines": [
   "ところが　この湾には",
   "船を安全に泊められる場所も"
  ]
 },
 {
  "scene": "S09",
  "start": 193.622,
  "end": 195.768,
  "lines": [
   "頼れる真水もありませんでした"
  ]
 },
 {
  "scene": "S09",
  "start": 196.118,
  "end": 199.275,
  "lines": [
   "総督のフィリップは",
   "北のポートジャクソンへ進み"
  ]
 },
 {
  "scene": "S09",
  "start": 199.275,
  "end": 201.141,
  "lines": [
   "シドニー・コーブを選びます"
  ]
 },
 {
  "scene": "S09",
  "start": 201.491,
  "end": 205.556,
  "lines": [
   "そこには　船を守れる入り江と",
   "淡水の小川がありました"
  ]
 },
 {
  "scene": "S09",
  "start": 205.906,
  "end": 208.241,
  "lines": [
   "のちにタンク・ストリームと呼ばれる流れです"
  ]
 },
 {
  "scene": "S09",
  "start": 208.591,
  "end": 211.424,
  "lines": [
   "今のシドニーは　この入り江から始まりました"
  ]
 },
 {
  "scene": "S10",
  "start": 212.324,
  "end": 216.168,
  "lines": [
   "ただし　この入り江は",
   "誰もいない土地ではありませんでした"
  ]
 },
 {
  "scene": "S10",
  "start": 216.518,
  "end": 222.321,
  "lines": [
   "この大陸では　植民地化よりはるか昔から",
   "先住民の人々が暮らしてきました"
  ]
 },
 {
  "scene": "S10",
  "start": 222.671,
  "end": 225.211,
  "lines": [
   "シドニー湾のまわりも　その一つです"
  ]
 },
 {
  "scene": "S10",
  "start": 225.561,
  "end": 230.391,
  "lines": [
   "植民地が広がるにつれて",
   "先住民の人々は土地を奪われていきました"
  ]
 },
 {
  "scene": "S10",
  "start": 230.741,
  "end": 234.203,
  "lines": [
   "今の大都市の地図は",
   "その歴史の上に描かれています"
  ]
 },
 {
  "scene": "S11",
  "start": 235.103,
  "end": 240.659,
  "lines": [
   "では　船が交通の主役だった時代が終わっても",
   "なぜ大都市は大きいままなのか"
  ]
 },
 {
  "scene": "S11",
  "start": 241.009,
  "end": 242.991,
  "lines": [
   "三つ目の理由　仕事です"
  ]
 },
 {
  "scene": "S11",
  "start": 243.341,
  "end": 246.993,
  "lines": [
   "人が多い街には",
   "働き手を求める企業が集まります"
  ]
 },
 {
  "scene": "S11",
  "start": 247.343,
  "end": 252.747,
  "lines": [
   "企業が集まれば　仕事の選択肢が増え",
   "それを求めて　また人が集まる"
  ]
 },
 {
  "scene": "S11",
  "start": 253.097,
  "end": 255.615,
  "lines": [
   "人と仕事は　互いを引き寄せ合います"
  ]
 },
 {
  "scene": "S12",
  "start": 256.515,
  "end": 259.341,
  "lines": [
   "近くに集まると　得をすることがあります"
  ]
 },
 {
  "scene": "S12",
  "start": 259.691,
  "end": 261.707,
  "lines": [
   "専門の技術を持つ人に出会える"
  ]
 },
 {
  "scene": "S12",
  "start": 262.057,
  "end": 266.029,
  "lines": [
   "取引先や大学　研究機関と　すぐにつながれる"
  ]
 },
 {
  "scene": "S12",
  "start": 266.379,
  "end": 270.412,
  "lines": [
   "港や空港　鉄道といった設備を　大勢で使える"
  ]
 },
 {
  "scene": "S12",
  "start": 270.762,
  "end": 275.286,
  "lines": [
   "この近さの強みが　大都市の仕事を支えています"
  ]
 },
 {
  "scene": "S12",
  "start": 275.636,
  "end": 280.605,
  "lines": [
   "そして　住宅費の高さや混雑という負担も",
   "同じ集まりから生まれます"
  ]
 },
 {
  "scene": "S13",
  "start": 281.505,
  "end": 283.651,
  "lines": [
   "ここで　最初の地図に戻ります"
  ]
 },
 {
  "scene": "S13",
  "start": 284.001,
  "end": 285.603,
  "lines": [
   "暮らしを支える雨と気候"
  ]
 },
 {
  "scene": "S13",
  "start": 285.953,
  "end": 287.503,
  "lines": [
   "船と人を受け入れた港"
  ]
 },
 {
  "scene": "S13",
  "start": 287.853,
  "end": 289.449,
  "lines": [
   "そこに積み重なった仕事"
  ]
 },
 {
  "scene": "S13",
  "start": 289.799,
  "end": 293.465,
  "lines": [
   "三つの条件が重なった場所に",
   "大都市が育ちました"
  ]
 },
 {
  "scene": "S13",
  "start": 293.815,
  "end": 297.483,
  "lines": [
   "海の近くに大都市が並ぶのは",
   "この重なりの結果です"
  ]
 },
 {
  "scene": "S14",
  "start": 298.383,
  "end": 302.314,
  "lines": [
   "では　内陸の首都キャンベラは",
   "どう説明できるのか"
  ]
 },
 {
  "scene": "S14",
  "start": 302.664,
  "end": 304.266,
  "lines": [
   "答えは　政治です"
  ]
 },
 {
  "scene": "S14",
  "start": 304.616,
  "end": 307.254,
  "lines": [
   "新しい連邦の首都を　どこに置くか"
  ]
 },
 {
  "scene": "S14",
  "start": 307.604,
  "end": 313.12,
  "lines": [
   "シドニーでもメルボルンでもない場所が探され",
   "一九〇八年　連邦議会は"
  ]
 },
 {
  "scene": "S14",
  "start": 313.12,
  "end": 316.509,
  "lines": [
   "ヤス・キャンベラ地域を首都の場所に決めました"
  ]
 },
 {
  "scene": "S15",
  "start": 317.409,
  "end": 320.328,
  "lines": [
   "その前に　憲法が条件を決めていました"
  ]
 },
 {
  "scene": "S15",
  "start": 320.678,
  "end": 323.47,
  "lines": [
   "首都は　ニューサウスウェールズ州の中に置く"
  ]
 },
 {
  "scene": "S15",
  "start": 323.82,
  "end": 328.559,
  "lines": [
   "ただし　シドニーから少なくとも百マイル",
   "約百六十キロ離す"
  ]
 },
 {
  "scene": "S15",
  "start": 328.909,
  "end": 333.358,
  "lines": [
   "港から自然に育った街ではなく",
   "条件に合わせて選ばれた場所"
  ]
 },
 {
  "scene": "S15",
  "start": 333.708,
  "end": 334.783,
  "lines": [
   "それがキャンベラです"
  ]
 },
 {
  "scene": "S15",
  "start": 335.133,
  "end": 338.101,
  "lines": [
   "人の決断もまた　地図の上に都市を生みます"
  ]
 },
 {
  "scene": "S16",
  "start": 339.001,
  "end": 342.588,
  "lines": [
   "もう一つ",
   "内陸の見え方にも気をつけたいところです"
  ]
 },
 {
  "scene": "S16",
  "start": 342.938,
  "end": 345.962,
  "lines": [
   "大都市がないことは",
   "何もないことではありません"
  ]
 },
 {
  "scene": "S16",
  "start": 346.312,
  "end": 350.34,
  "lines": [
   "オーストラリアの内陸には",
   "牛や羊の放牧地が広がり"
  ]
 },
 {
  "scene": "S16",
  "start": 350.34,
  "end": 352.617,
  "lines": [
   "自然保護区があり　町があり"
  ]
 },
 {
  "scene": "S16",
  "start": 352.617,
  "end": 356.021,
  "lines": [
   "先住民の人々が暮らし続ける土地があります"
  ]
 },
 {
  "scene": "S16",
  "start": 356.371,
  "end": 360.877,
  "lines": [
   "人口の多さだけで地図を見ると",
   "こうした土地の役割が見えなくなります"
  ]
 },
 {
  "scene": "S17",
  "start": 361.777,
  "end": 365.15,
  "lines": [
   "オーストラリアの大都市が",
   "海の近くに集まる理由"
  ]
 },
 {
  "scene": "S17",
  "start": 365.5,
  "end": 369.475,
  "lines": [
   "それは",
   "内陸が砂漠だからの一言では終わりません"
  ]
 },
 {
  "scene": "S17",
  "start": 369.825,
  "end": 372.055,
  "lines": [
   "雨を左右する　空気の流れ"
  ]
 },
 {
  "scene": "S17",
  "start": 372.405,
  "end": 374.51,
  "lines": [
   "船と真水がそろった　港"
  ]
 },
 {
  "scene": "S17",
  "start": 374.86,
  "end": 377.217,
  "lines": [
   "そして　人と仕事が呼び合う力"
  ]
 },
 {
  "scene": "S17",
  "start": 377.567,
  "end": 380.87,
  "lines": [
   "三つが重なった場所に　五つの大都市があります"
  ]
 },
 {
  "scene": "S17",
  "start": 381.22,
  "end": 385.227,
  "lines": [
   "地図の点の一つひとつに",
   "そこに人が集まった理由があります"
  ]
 },
 {
  "scene": "S18",
  "start": 386.127,
  "end": 386.957,
  "lines": [
   "地球の事情"
  ]
 },
 {
  "scene": "S18",
  "start": 387.307,
  "end": 390.646,
  "lines": [
   "次の地図でも",
   "その理由を一緒に読み解いていきます"
  ]
 },
 {
  "scene": "S18",
  "start": 390.996,
  "end": 393.13,
  "lines": [
   "また　次の地図でお会いしましょう"
  ]
 }
]