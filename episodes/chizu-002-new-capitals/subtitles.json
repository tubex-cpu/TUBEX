[
 {
  "scene": "S01",
  "start": 0.0,
  "end": 3.104,
  "lines": [
   "世界地図で　首都と大きな都市を見比べてみます"
  ]
 },
 {
  "scene": "S01",
  "start": 3.454,
  "end": 6.409,
  "lines": [
   "アメリカの首都は",
   "ニューヨークではなくワシントン"
  ]
 },
 {
  "scene": "S01",
  "start": 6.759,
  "end": 9.967,
  "lines": [
   "ブラジルの首都は",
   "リオデジャネイロではなくブラジリア"
  ]
 },
 {
  "scene": "S01",
  "start": 10.317,
  "end": 12.984,
  "lines": [
   "オーストラリアは　シドニーではなくキャンベラ"
  ]
 },
 {
  "scene": "S01",
  "start": 13.334,
  "end": 15.854,
  "lines": [
   "ナイジェリアは　ラゴスではなくアブジャです"
  ]
 },
 {
  "scene": "S02",
  "start": 16.754,
  "end": 19.545,
  "lines": [
   "この四つの首都には　共通点があります"
  ]
 },
 {
  "scene": "S02",
  "start": 19.895,
  "end": 24.224,
  "lines": [
   "どれも　首都にするために計画して",
   "新しく造った街です"
  ]
 },
 {
  "scene": "S02",
  "start": 24.574,
  "end": 27.977,
  "lines": [
   "そして今　インドネシアも",
   "新しい首都を造っています"
  ]
 },
 {
  "scene": "S02",
  "start": 28.327,
  "end": 31.285,
  "lines": [
   "なぜ国は　わざわざ首都をゼロから造るのか"
  ]
 },
 {
  "scene": "S02",
  "start": 31.635,
  "end": 34.735,
  "lines": [
   "地図で見ると　理由は四つの型に分かれます"
  ]
 },
 {
  "scene": "S03",
  "start": 35.635,
  "end": 39.195,
  "lines": [
   "一つ目の型は",
   "大都市どうしの争いを避けることです"
  ]
 },
 {
  "scene": "S03",
  "start": 39.545,
  "end": 44.425,
  "lines": [
   "独立したばかりのアメリカでは",
   "首都をどこに置くかで州どうしが対立しました"
  ]
 },
 {
  "scene": "S03",
  "start": 44.775,
  "end": 47.991,
  "lines": [
   "一七九〇年　議会は首都法を定め"
  ]
 },
 {
  "scene": "S03",
  "start": 47.991,
  "end": 51.608,
  "lines": [
   "ポトマック川のほとりに",
   "新しい首都を造ると決めました"
  ]
 },
 {
  "scene": "S03",
  "start": 51.958,
  "end": 55.269,
  "lines": [
   "首都の場所は",
   "州の借金を国がまとめて引き受ける"
  ]
 },
 {
  "scene": "S03",
  "start": 55.269,
  "end": 57.526,
  "lines": [
   "法律との取引の中で決まりました"
  ]
 },
 {
  "scene": "S04",
  "start": 58.426,
  "end": 62.114,
  "lines": [
   "それから十年間は",
   "フィラデルフィアが仮の首都になりました"
  ]
 },
 {
  "scene": "S04",
  "start": 62.464,
  "end": 66.644,
  "lines": [
   "その間に　ポトマック川のほとりで",
   "新しい街づくりが進みます"
  ]
 },
 {
  "scene": "S04",
  "start": 66.994,
  "end": 71.497,
  "lines": [
   "一八〇〇年十一月",
   "議会はワシントンで初めて開かれました"
  ]
 },
 {
  "scene": "S05",
  "start": 72.397,
  "end": 76.243,
  "lines": [
   "前回の動画で見たオーストラリアの",
   "キャンベラも　同じ型です"
  ]
 },
 {
  "scene": "S05",
  "start": 76.593,
  "end": 82.175,
  "lines": [
   "シドニーとメルボルンという二つの大都市の",
   "どちらでもなく　憲法の条件に合う場所として"
  ]
 },
 {
  "scene": "S05",
  "start": 82.175,
  "end": 85.108,
  "lines": [
   "一九〇八年に首都の場所が決まりました"
  ]
 },
 {
  "scene": "S05",
  "start": 85.458,
  "end": 89.937,
  "lines": [
   "議会がキャンベラで初めて開かれたのは",
   "一九二七年です"
  ]
 },
 {
  "scene": "S06",
  "start": 90.837,
  "end": 93.795,
  "lines": [
   "二つ目の型は　国の内陸を開くことです"
  ]
 },
 {
  "scene": "S06",
  "start": 94.145,
  "end": 98.57,
  "lines": [
   "ブラジルの首都だったリオデジャネイロは",
   "大西洋に面した港町です"
  ]
 },
 {
  "scene": "S06",
  "start": 98.92,
  "end": 101.888,
  "lines": [
   "一八九一年",
   "共和国で最初の憲法に"
  ]
 },
 {
  "scene": "S06",
  "start": 101.888,
  "end": 106.638,
  "lines": [
   "国の中央の高原に",
   "未来の首都のための土地を用意する"
  ]
 },
 {
  "scene": "S06",
  "start": 106.638,
  "end": 108.404,
  "lines": [
   "という条文が入りました"
  ]
 },
 {
  "scene": "S07",
  "start": 109.304,
  "end": 113.252,
  "lines": [
   "実際に首都が造られたのは",
   "それから六十年以上あとです"
  ]
 },
 {
  "scene": "S07",
  "start": 113.602,
  "end": 119.472,
  "lines": [
   "一九五六年に建設が始まり",
   "一九六〇年四月二十一日"
  ]
 },
 {
  "scene": "S07",
  "start": 119.472,
  "end": 121.793,
  "lines": [
   "ブラジリアは新しい首都になりました"
  ]
 },
 {
  "scene": "S07",
  "start": 122.143,
  "end": 127.767,
  "lines": [
   "街の計画はルシオ・コスタ",
   "主な建物の設計はオスカー・ニーマイヤーです"
  ]
 },
 {
  "scene": "S08",
  "start": 128.667,
  "end": 132.7,
  "lines": [
   "三つ目の型は　どの集団にも",
   "偏らない場所を選ぶことです"
  ]
 },
 {
  "scene": "S08",
  "start": 133.05,
  "end": 137.267,
  "lines": [
   "ナイジェリアの首都だったラゴスは",
   "南西の海岸にある港町です"
  ]
 },
 {
  "scene": "S08",
  "start": 137.617,
  "end": 140.847,
  "lines": [
   "ナイジェリアには　多くの民族と宗教があります"
  ]
 },
 {
  "scene": "S08",
  "start": 141.197,
  "end": 149.013,
  "lines": [
   "一九七五年　政府の委員会が首都の場所を見直し",
   "翌年　首都をラゴスから移すことが決まりました"
  ]
 },
 {
  "scene": "S09",
  "start": 149.913,
  "end": 155.802,
  "lines": [
   "選ばれたのは　国の中央にあり",
   "多くの民族と宗教のどれにも偏らない土地でした"
  ]
 },
 {
  "scene": "S09",
  "start": 156.152,
  "end": 160.941,
  "lines": [
   "そこに新しい首都アブジャが造られ",
   "一九九一年十二月"
  ]
 },
 {
  "scene": "S09",
  "start": 160.941,
  "end": 163.45,
  "lines": [
   "政府はラゴスからアブジャに移りました"
  ]
 },
 {
  "scene": "S10",
  "start": 164.35,
  "end": 167.848,
  "lines": [
   "四つ目の型は",
   "今の首都が限界に来ていることです"
  ]
 },
 {
  "scene": "S10",
  "start": 168.198,
  "end": 172.054,
  "lines": [
   "インドネシアの首都ジャカルタは",
   "ジャワ島の北の海岸にあります"
  ]
 },
 {
  "scene": "S10",
  "start": 172.404,
  "end": 175.459,
  "lines": [
   "渋滞　大気汚染　そして地盤沈下"
  ]
 },
 {
  "scene": "S10",
  "start": 175.809,
  "end": 178.374,
  "lines": [
   "街の一部は　少しずつ沈んでいます"
  ]
 },
 {
  "scene": "S11",
  "start": 179.274,
  "end": 182.063,
  "lines": [
   "二〇二二年　インドネシアは法律で"
  ]
 },
 {
  "scene": "S11",
  "start": 182.063,
  "end": 186.964,
  "lines": [
   "ボルネオ島の東カリマンタンに",
   "新しい首都ヌサンタラを造ることを決めました"
  ]
 },
 {
  "scene": "S11",
  "start": 187.314,
  "end": 192.016,
  "lines": [
   "ただし　法律の上では",
   "大統領令が出るまでジャカルタが首都です"
  ]
 },
 {
  "scene": "S11",
  "start": 192.366,
  "end": 196.754,
  "lines": [
   "二〇二六年五月",
   "憲法裁判所もその規定を認めました"
  ]
 },
 {
  "scene": "S11",
  "start": 197.104,
  "end": 199.422,
  "lines": [
   "首都の移転は　まだ終わっていません"
  ]
 },
 {
  "scene": "S12",
  "start": 200.322,
  "end": 202.362,
  "lines": [
   "ここで　世界地図に戻ります"
  ]
 },
 {
  "scene": "S12",
  "start": 202.712,
  "end": 206.065,
  "lines": [
   "大都市どうしの争いを避けた",
   "ワシントンとキャンベラ"
  ]
 },
 {
  "scene": "S12",
  "start": 206.415,
  "end": 208.745,
  "lines": [
   "内陸を開くための　ブラジリア"
  ]
 },
 {
  "scene": "S12",
  "start": 209.095,
  "end": 212.268,
  "lines": [
   "どの集団にも偏らない場所を選んだ　アブジャ"
  ]
 },
 {
  "scene": "S12",
  "start": 212.618,
  "end": 216.121,
  "lines": [
   "そして　今の首都の限界から生まれた",
   "ヌサンタラ"
  ]
 },
 {
  "scene": "S13",
  "start": 217.021,
  "end": 220.728,
  "lines": [
   "首都の場所は　海や川",
   "地形だけでは決まりません"
  ]
 },
 {
  "scene": "S13",
  "start": 221.078,
  "end": 224.162,
  "lines": [
   "国をどうまとめ　人と仕事をどこへ広げるのか"
  ]
 },
 {
  "scene": "S13",
  "start": 224.512,
  "end": 227.774,
  "lines": [
   "その決断が　地図の上に新しい街を生みます"
  ]
 },
 {
  "scene": "S14",
  "start": 228.674,
  "end": 229.504,
  "lines": [
   "地球の事情"
  ]
 },
 {
  "scene": "S14",
  "start": 229.854,
  "end": 233.193,
  "lines": [
   "次の地図でも",
   "その理由を一緒に読み解いていきます"
  ]
 },
 {
  "scene": "S14",
  "start": 233.543,
  "end": 235.677,
  "lines": [
   "また　次の地図でお会いしましょう"
  ]
 }
]