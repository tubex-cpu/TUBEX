[
 {
  "scene": "S01",
  "start": 0.0,
  "end": 2.802,
  "lines": [
   "アメリカの真ん中を　空から見下ろします"
  ]
 },
 {
  "scene": "S01",
  "start": 3.402,
  "end": 7.504,
  "lines": [
   "茶色い大地に　緑の丸が",
   "びっしりと並んでいます"
  ]
 },
 {
  "scene": "S01",
  "start": 8.104,
  "end": 12.265,
  "lines": [
   "一つの丸の直径は",
   "八百メートルから千六百メートル"
  ]
 },
 {
  "scene": "S01",
  "start": 12.865,
  "end": 17.323,
  "lines": [
   "大きな丸なら　端から端まで歩くと",
   "二十分かかります"
  ]
 },
 {
  "scene": "S02",
  "start": 19.123,
  "end": 21.781,
  "lines": [
   "この辺りに　人はあまり住んでいません"
  ]
 },
 {
  "scene": "S02",
  "start": 22.381,
  "end": 27.164,
  "lines": [
   "グレートプレーンズと呼ばれる大平原の郡は",
   "ほとんどが都市圏の外です"
  ]
 },
 {
  "scene": "S02",
  "start": 27.764,
  "end": 30.016,
  "lines": [
   "人は少ないのに　畑は丸い"
  ]
 },
 {
  "scene": "S02",
  "start": 30.616,
  "end": 34.01,
  "lines": [
   "アメリカの真ん中は　なぜ丸い畑だらけなのか"
  ]
 },
 {
  "scene": "S02",
  "start": 34.61,
  "end": 41.893,
  "lines": [
   "答えを追っていくと　地図の上の一本の線",
   "開拓の碁盤の目　日本の国土より広い地下の水"
  ]
 },
 {
  "scene": "S02",
  "start": 41.893,
  "end": 45.462,
  "lines": [
   "そして　遠い砂漠の丸にまでつながっていきます"
  ]
 },
 {
  "scene": "S03",
  "start": 47.262,
  "end": 52.757,
  "lines": [
   "大平原全体の人口は",
   "一九五〇年の四百九十万人から"
  ]
 },
 {
  "scene": "S03",
  "start": 52.757,
  "end": 56.232,
  "lines": [
   "二〇〇七年には九百九十万人に増えました"
  ]
 },
 {
  "scene": "S03",
  "start": 56.832,
  "end": 58.873,
  "lines": [
   "けれど　増えたのは都市です"
  ]
 },
 {
  "scene": "S03",
  "start": 59.473,
  "end": 61.458,
  "lines": [
   "都市圏に住む人の割合は"
  ]
 },
 {
  "scene": "S03",
  "start": 61.458,
  "end": 65.436,
  "lines": [
   "三十九パーセントから六十八パーセントに",
   "上がりました"
  ]
 },
 {
  "scene": "S03",
  "start": 66.036,
  "end": 72.455,
  "lines": [
   "カンザス州の大平原の五十八の郡のうち",
   "四十六の郡では　人口が減りました"
  ]
 },
 {
  "scene": "S03",
  "start": 73.055,
  "end": 78.95,
  "lines": [
   "郡の六割ほどは　一九五〇年より前に",
   "人口が一番多かったのです"
  ]
 },
 {
  "scene": "S04",
  "start": 80.75,
  "end": 83.183,
  "lines": [
   "舞台は　カンザス州の南西部"
  ]
 },
 {
  "scene": "S04",
  "start": 83.783,
  "end": 85.734,
  "lines": [
   "ガーデンシティという町のまわりです"
  ]
 },
 {
  "scene": "S04",
  "start": 86.334,
  "end": 89.969,
  "lines": [
   "町を出ると　まわりは見渡すかぎりの平らな畑"
  ]
 },
 {
  "scene": "S04",
  "start": 90.569,
  "end": 93.607,
  "lines": [
   "その畑の多くが　丸い形をしています"
  ]
 },
 {
  "scene": "S05",
  "start": 95.407,
  "end": 100.189,
  "lines": [
   "一九七二年　この町のまわりの畑は　四角でした"
  ]
 },
 {
  "scene": "S05",
  "start": 100.789,
  "end": 109.071,
  "lines": [
   "それが　一九八八年　二〇一一年　二〇一五年と",
   "少しずつ丸に置き換わっていきます"
  ]
 },
 {
  "scene": "S05",
  "start": 109.671,
  "end": 112.905,
  "lines": [
   "丸い畑は　昔からあったわけではありません"
  ]
 },
 {
  "scene": "S05",
  "start": 113.505,
  "end": 116.669,
  "lines": [
   "四角い畑が　あとから丸に変わったのです"
  ]
 },
 {
  "scene": "S06",
  "start": 118.469,
  "end": 120.809,
  "lines": [
   "丸の真ん中には　井戸があります"
  ]
 },
 {
  "scene": "S06",
  "start": 121.409,
  "end": 124.487,
  "lines": [
   "井戸から水をくみ上げ　長い管に送ります"
  ]
 },
 {
  "scene": "S06",
  "start": 125.087,
  "end": 130.898,
  "lines": [
   "管は　車輪のついた塔に支えられていて",
   "井戸を中心に　ぐるりと回ります"
  ]
 },
 {
  "scene": "S06",
  "start": 131.498,
  "end": 133.829,
  "lines": [
   "回りながら　管から水をまく"
  ]
 },
 {
  "scene": "S06",
  "start": 134.429,
  "end": 136.661,
  "lines": [
   "だから　畑が丸くなります"
  ]
 },
 {
  "scene": "S07",
  "start": 138.461,
  "end": 143.536,
  "lines": [
   "管を支える塔には",
   "一つずつ電動機がついていて　車輪を回します"
  ]
 },
 {
  "scene": "S07",
  "start": 144.136,
  "end": 149.948,
  "lines": [
   "一番外側の塔が進むのは",
   "一時間に約百十メートルから百七十メートル"
  ]
 },
 {
  "scene": "S07",
  "start": 150.548,
  "end": 153.747,
  "lines": [
   "人が歩く速さの　三十分の一ほどです"
  ]
 },
 {
  "scene": "S07",
  "start": 154.347,
  "end": 159.912,
  "lines": [
   "直径八百メートルの丸なら",
   "一周するのに　半日から一日かかります"
  ]
 },
 {
  "scene": "S08",
  "start": 161.712,
  "end": 164.616,
  "lines": [
   "この機械を　センターピボットと呼びます"
  ]
 },
 {
  "scene": "S08",
  "start": 165.216,
  "end": 167.819,
  "lines": [
   "中心の軸で回る　という意味です"
  ]
 },
 {
  "scene": "S08",
  "start": 168.419,
  "end": 172.37,
  "lines": [
   "空から見える緑の丸は",
   "この機械が水をまいた跡です"
  ]
 },
 {
  "scene": "S08",
  "start": 172.97,
  "end": 175.972,
  "lines": [
   "水が届いたところだけが　緑になります"
  ]
 },
 {
  "scene": "S09",
  "start": 177.772,
  "end": 180.28,
  "lines": [
   "畑の区画は　もともと四角です"
  ]
 },
 {
  "scene": "S09",
  "start": 180.88,
  "end": 182.689,
  "lines": [
   "一辺は約八百メートル"
  ]
 },
 {
  "scene": "S09",
  "start": 183.289,
  "end": 186.85,
  "lines": [
   "そこに丸を入れると　四つの隅に水が届きません"
  ]
 },
 {
  "scene": "S09",
  "start": 187.45,
  "end": 192.382,
  "lines": [
   "百六十エーカーの区画のうち",
   "水が届くのは約百二十五エーカー"
  ]
 },
 {
  "scene": "S09",
  "start": 192.982,
  "end": 195.324,
  "lines": [
   "四隅は　乾いたまま残ります"
  ]
 },
 {
  "scene": "S09",
  "start": 195.924,
  "end": 198.926,
  "lines": [
   "それでも　丸い畑のほうが選ばれました"
  ]
 },
 {
  "scene": "S09",
  "start": 199.526,
  "end": 205.391,
  "lines": [
   "地面に水を流すやり方より",
   "まく水と肥料の量を　細かく決められるからです"
  ]
 },
 {
  "scene": "S10",
  "start": 207.191,
  "end": 211.392,
  "lines": [
   "この機械を考えたのは",
   "フランク・ザイバックという人です"
  ]
 },
 {
  "scene": "S10",
  "start": 211.992,
  "end": 215.989,
  "lines": [
   "一九五二年　アメリカで特許が認められました"
  ]
 },
 {
  "scene": "S10",
  "start": 216.589,
  "end": 219.513,
  "lines": [
   "名前は　自分で進む散水の機械"
  ]
 },
 {
  "scene": "S10",
  "start": 220.113,
  "end": 224.933,
  "lines": [
   "一九五〇年代の半ばに",
   "ネブラスカの会社が作り始めます"
  ]
 },
 {
  "scene": "S10",
  "start": 225.533,
  "end": 227.905,
  "lines": [
   "最初の年に作ったのは　五台"
  ]
 },
 {
  "scene": "S10",
  "start": 228.505,
  "end": 232.528,
  "lines": [
   "一九六〇年には　一年に五十台になりました"
  ]
 },
 {
  "scene": "S11",
  "start": 234.328,
  "end": 237.493,
  "lines": [
   "一九六九年　特許が切れます"
  ]
 },
 {
  "scene": "S11",
  "start": 238.093,
  "end": 242.002,
  "lines": [
   "ほかの会社も　同じしくみの",
   "機械を作れるようになりました"
  ]
 },
 {
  "scene": "S11",
  "start": 242.602,
  "end": 249.621,
  "lines": [
   "一九七二年に四角かったガーデンシティの畑が",
   "丸に変わっていったのは　このあとのことです"
  ]
 },
 {
  "scene": "S12",
  "start": 251.421,
  "end": 256.723,
  "lines": [
   "いま　丸い畑がいちばん多い州の一つが",
   "カンザスの北のネブラスカです"
  ]
 },
 {
  "scene": "S12",
  "start": 257.323,
  "end": 261.26,
  "lines": [
   "ネブラスカの水をまく畑は　約九百十万エーカー"
  ]
 },
 {
  "scene": "S12",
  "start": 261.86,
  "end": 263.261,
  "lines": [
   "アメリカで一番広い"
  ]
 },
 {
  "scene": "S12",
  "start": 263.861,
  "end": 267.427,
  "lines": [
   "その約八十五パーセントが",
   "センターピボットです"
  ]
 },
 {
  "scene": "S13",
  "start": 269.227,
  "end": 273.434,
  "lines": [
   "では　なぜ　わざわざ井戸を掘って",
   "水をまくのか"
  ]
 },
 {
  "scene": "S13",
  "start": 274.034,
  "end": 275.85,
  "lines": [
   "答えは　空にあります"
  ]
 },
 {
  "scene": "S13",
  "start": 276.45,
  "end": 279.091,
  "lines": [
   "この大平原には　雨が足りません"
  ]
 },
 {
  "scene": "S14",
  "start": 280.891,
  "end": 284.08,
  "lines": [
   "アメリカの地図に　縦に一本の線を引きます"
  ]
 },
 {
  "scene": "S14",
  "start": 284.68,
  "end": 285.666,
  "lines": [
   "西経百度"
  ]
 },
 {
  "scene": "S14",
  "start": 286.266,
  "end": 288.597,
  "lines": [
   "カンザスの真ん中あたりを通る線です"
  ]
 },
 {
  "scene": "S14",
  "start": 289.197,
  "end": 294.79,
  "lines": [
   "一八七八年",
   "探検家のジョン・ウェズリー・パウエルは"
  ]
 },
 {
  "scene": "S14",
  "start": 294.79,
  "end": 302.148,
  "lines": [
   "議会への報告で　この線より西は　一年の",
   "雨が平均二十インチ　約五百ミリに届かない"
  ]
 },
 {
  "scene": "S14",
  "start": 302.148,
  "end": 303.131,
  "lines": [
   "と書きました"
  ]
 },
 {
  "scene": "S14",
  "start": 303.731,
  "end": 306.365,
  "lines": [
   "ほとんどの作物には　足りない量です"
  ]
 },
 {
  "scene": "S15",
  "start": 308.165,
  "end": 312.022,
  "lines": [
   "ガーデンシティの一年の雨は　約四百九十七ミリ"
  ]
 },
 {
  "scene": "S15",
  "start": 312.622,
  "end": 315.569,
  "lines": [
   "日本の平均は　約千七百ミリ"
  ]
 },
 {
  "scene": "S15",
  "start": 316.169,
  "end": 319.858,
  "lines": [
   "ガーデンシティの雨は",
   "日本の三分の一もありません"
  ]
 },
 {
  "scene": "S16",
  "start": 321.658,
  "end": 325.259,
  "lines": [
   "ところが　とうもろこしは",
   "たくさんの水を飲みます"
  ]
 },
 {
  "scene": "S16",
  "start": 325.859,
  "end": 330.053,
  "lines": [
   "カンザス州北西部のとうもろこしは",
   "一回育てるあいだに"
  ]
 },
 {
  "scene": "S16",
  "start": 330.053,
  "end": 332.847,
  "lines": [
   "約五百八十ミリの水を使います"
  ]
 },
 {
  "scene": "S16",
  "start": 333.447,
  "end": 336.523,
  "lines": [
   "一年に降る雨を　全部あげても足りません"
  ]
 },
 {
  "scene": "S16",
  "start": 337.123,
  "end": 343.25,
  "lines": [
   "しかも　雨は一年かけて降り",
   "とうもろこしは　夏の数か月で水を使います"
  ]
 },
 {
  "scene": "S16",
  "start": 343.85,
  "end": 347.254,
  "lines": [
   "一番水を飲む時期には　一日に約九ミリ"
  ]
 },
 {
  "scene": "S16",
  "start": 347.854,
  "end": 352.187,
  "lines": [
   "ガーデンシティの雨を一日あたりにすると",
   "約一・四ミリです"
  ]
 },
 {
  "scene": "S16",
  "start": 352.787,
  "end": 355.579,
  "lines": [
   "六倍以上の水が　毎日いります"
  ]
 },
 {
  "scene": "S17",
  "start": 357.379,
  "end": 360.141,
  "lines": [
   "この線は　畑の景色を分けています"
  ]
 },
 {
  "scene": "S17",
  "start": 360.741,
  "end": 365.612,
  "lines": [
   "線の東では　作物の七割が",
   "湿り気を好むとうもろこし"
  ]
 },
 {
  "scene": "S17",
  "start": 366.212,
  "end": 369.693,
  "lines": [
   "線の西では　乾きに強い小麦が中心です"
  ]
 },
 {
  "scene": "S17",
  "start": 370.293,
  "end": 374.274,
  "lines": [
   "西の農場は　数が少なく　一つ一つが大きい"
  ]
 },
 {
  "scene": "S18",
  "start": 376.074,
  "end": 378.253,
  "lines": [
   "その境目が　動いています"
  ]
 },
 {
  "scene": "S18",
  "start": 378.853,
  "end": 385.477,
  "lines": [
   "一九八〇年ごろからの雨と気温のデータで見ると",
   "乾いた西と湿った東の境は"
  ]
 },
 {
  "scene": "S18",
  "start": 385.477,
  "end": 391.055,
  "lines": [
   "約二百二十五キロ東へ移り",
   "西経九十八度の近くに来ていました"
  ]
 },
 {
  "scene": "S18",
  "start": 391.655,
  "end": 394.622,
  "lines": [
   "乾いた土地が　東へ広がっているのです"
  ]
 },
 {
  "scene": "S18",
  "start": 395.222,
  "end": 400.36,
  "lines": [
   "この境目は　今世紀のうちに",
   "さらに東へ動くと予測されています"
  ]
 },
 {
  "scene": "S19",
  "start": 402.16,
  "end": 405.269,
  "lines": [
   "それでも　人はこの土地に畑をつくりました"
  ]
 },
 {
  "scene": "S19",
  "start": 405.869,
  "end": 409.013,
  "lines": [
   "その前に　アメリカは土地に線を引いています"
  ]
 },
 {
  "scene": "S19",
  "start": 409.613,
  "end": 415.658,
  "lines": [
   "一七八五年の法律で　西の土地は",
   "六マイル四方の升に分けられました"
  ]
 },
 {
  "scene": "S19",
  "start": 416.258,
  "end": 420.498,
  "lines": [
   "その中を　さらに一マイル四方の",
   "三十六の区画に分けます"
  ]
 },
 {
  "scene": "S19",
  "start": 421.098,
  "end": 423.851,
  "lines": [
   "一つの区画は　六百四十エーカー"
  ]
 },
 {
  "scene": "S19",
  "start": 424.451,
  "end": 427.538,
  "lines": [
   "その四分の一が　百六十エーカーです"
  ]
 },
 {
  "scene": "S20",
  "start": 429.338,
  "end": 432.565,
  "lines": [
   "ここで　最初の丸の大きさを思い出してください"
  ]
 },
 {
  "scene": "S20",
  "start": 433.165,
  "end": 436.311,
  "lines": [
   "直径八百メートルと　千六百メートル"
  ]
 },
 {
  "scene": "S20",
  "start": 436.911,
  "end": 440.861,
  "lines": [
   "百六十エーカーの区画の一辺は　約八百メートル"
  ]
 },
 {
  "scene": "S20",
  "start": 441.461,
  "end": 445.623,
  "lines": [
   "一マイル四方の区画の一辺は",
   "約千六百メートルです"
  ]
 },
 {
  "scene": "S20",
  "start": 446.223,
  "end": 452.291,
  "lines": [
   "丸の大きさは　二百四十年前に引かれた碁盤の",
   "目の大きさに　ぴったり合っています"
  ]
 },
 {
  "scene": "S21",
  "start": 454.091,
  "end": 459.697,
  "lines": [
   "一八六二年　アメリカは",
   "ホームステッド法という法律をつくります"
  ]
 },
 {
  "scene": "S21",
  "start": 460.297,
  "end": 466.333,
  "lines": [
   "測量した国の土地を　百六十エーカーずつ",
   "住んで耕す人に渡す法律です"
  ]
 },
 {
  "scene": "S21",
  "start": 466.933,
  "end": 471.149,
  "lines": [
   "百六十エーカーは",
   "さっきの四角い区画と同じ広さです"
  ]
 },
 {
  "scene": "S21",
  "start": 471.749,
  "end": 473.379,
  "lines": [
   "約六十五ヘクタール"
  ]
 },
 {
  "scene": "S21",
  "start": 473.979,
  "end": 477.261,
  "lines": [
   "東京ドームの建物の　約十四個分です"
  ]
 },
 {
  "scene": "S21",
  "start": 477.861,
  "end": 483.659,
  "lines": [
   "この法律で人の手に渡った土地は",
   "合わせてアメリカの面積の約一割になりました"
  ]
 },
 {
  "scene": "S22",
  "start": 485.459,
  "end": 489.555,
  "lines": [
   "けれど　雨の少ない土地は　耕すと土が乾きます"
  ]
 },
 {
  "scene": "S22",
  "start": 490.155,
  "end": 495.463,
  "lines": [
   "一九三〇年代　大平原は",
   "砂嵐に何度も襲われました"
  ]
 },
 {
  "scene": "S22",
  "start": 496.063,
  "end": 498.779,
  "lines": [
   "一九三五年四月十四日"
  ]
 },
 {
  "scene": "S22",
  "start": 499.379,
  "end": 505.115,
  "lines": [
   "黒い日曜日と呼ばれる日　大きな砂嵐が",
   "中央の大平原をのみこみました"
  ]
 },
 {
  "scene": "S22",
  "start": 505.715,
  "end": 510.155,
  "lines": [
   "砂嵐は午前中にネブラスカで起こり",
   "次の日の明け方までに"
  ]
 },
 {
  "scene": "S22",
  "start": 510.155,
  "end": 514.534,
  "lines": [
   "約千三百キロ南のメキシコ国境の",
   "近くまで進みました"
  ]
 },
 {
  "scene": "S22",
  "start": 515.134,
  "end": 521.031,
  "lines": [
   "この年の四月　カンザス州のダッジシティでは",
   "濃い砂ぼこりの日が十四日ありました"
  ]
 },
 {
  "scene": "S23",
  "start": 522.831,
  "end": 525.369,
  "lines": [
   "雨に頼る畑は　日照りに弱い"
  ]
 },
 {
  "scene": "S23",
  "start": 525.969,
  "end": 529.314,
  "lines": [
   "そこで　人は空ではなく　足元を見ました"
  ]
 },
 {
  "scene": "S23",
  "start": 529.914,
  "end": 533.908,
  "lines": [
   "この大平原の下には",
   "大量の水が眠っていたからです"
  ]
 },
 {
  "scene": "S24",
  "start": 535.708,
  "end": 539.227,
  "lines": [
   "その水の層は　八つの州の下に広がっています"
  ]
 },
 {
  "scene": "S24",
  "start": 539.827,
  "end": 543.604,
  "lines": [
   "南はテキサスから",
   "北はサウスダコタとワイオミングまで"
  ]
 },
 {
  "scene": "S24",
  "start": 544.204,
  "end": 547.461,
  "lines": [
   "広さは　約四十五万平方キロメートル"
  ]
 },
 {
  "scene": "S24",
  "start": 548.061,
  "end": 550.902,
  "lines": [
   "日本の国土の　約一・二倍です"
  ]
 },
 {
  "scene": "S25",
  "start": 552.702,
  "end": 556.238,
  "lines": [
   "ただし　地下に大きな湖が",
   "あるわけではありません"
  ]
 },
 {
  "scene": "S25",
  "start": 556.838,
  "end": 562.413,
  "lines": [
   "この層は　砂や小石に　細かい泥が混じった",
   "固まっていない地層です"
  ]
 },
 {
  "scene": "S25",
  "start": 563.013,
  "end": 565.916,
  "lines": [
   "水は　その粒のすき間にしみこんでいます"
  ]
 },
 {
  "scene": "S25",
  "start": 566.516,
  "end": 572.567,
  "lines": [
   "砂や小石は　遠い昔",
   "ロッキー山脈から東へ流れた川が運んできました"
  ]
 },
 {
  "scene": "S25",
  "start": 573.167,
  "end": 578.592,
  "lines": [
   "ガーデンシティでくみ上げる水の中には",
   "氷河期から地下にあった水もふくまれています"
  ]
 },
 {
  "scene": "S26",
  "start": 580.392,
  "end": 584.415,
  "lines": [
   "水をふくんだ層の厚さは　平均で約六十メートル"
  ]
 },
 {
  "scene": "S26",
  "start": 585.015,
  "end": 588.147,
  "lines": [
   "厚いところでは　約三百メートルあります"
  ]
 },
 {
  "scene": "S26",
  "start": 588.747,
  "end": 592.281,
  "lines": [
   "この水を　井戸でくみ上げて　丸く回してまく"
  ]
 },
 {
  "scene": "S26",
  "start": 592.881,
  "end": 595.345,
  "lines": [
   "それが　丸い畑の正体です"
  ]
 },
 {
  "scene": "S27",
  "start": 597.145,
  "end": 600.435,
  "lines": [
   "アメリカで　畑に水をまくために使う地下水"
  ]
 },
 {
  "scene": "S27",
  "start": 601.035,
  "end": 604.496,
  "lines": [
   "その約三割を　この一つの層がまかなっています"
  ]
 },
 {
  "scene": "S27",
  "start": 605.096,
  "end": 607.489,
  "lines": [
   "くみ上げる量も　急に増えました"
  ]
 },
 {
  "scene": "S27",
  "start": 608.089,
  "end": 617.125,
  "lines": [
   "一九四九年から一九七四年までの二十五年で",
   "一年にくみ上げる水は　約四・八倍になりました"
  ]
 },
 {
  "scene": "S28",
  "start": 618.925,
  "end": 623.375,
  "lines": [
   "丸い畑で育つのは",
   "とうもろこし　小麦　ソルガム"
  ]
 },
 {
  "scene": "S28",
  "start": 623.975,
  "end": 626.105,
  "lines": [
   "ソルガムは　きびの仲間です"
  ]
 },
 {
  "scene": "S28",
  "start": 626.705,
  "end": 631.508,
  "lines": [
   "ガーデンシティのまわりでは",
   "こうした作物を育て　牛を飼っています"
  ]
 },
 {
  "scene": "S29",
  "start": 633.308,
  "end": 637.901,
  "lines": [
   "カンザス州の南西部には",
   "大きな牛肉の工場が集まっています"
  ]
 },
 {
  "scene": "S29",
  "start": 638.501,
  "end": 646.126,
  "lines": [
   "一九八〇年　ガーデンシティの隣の町ホルコムに",
   "当時世界最大の牛肉の工場ができました"
  ]
 },
 {
  "scene": "S30",
  "start": 647.926,
  "end": 650.979,
  "lines": [
   "日本も　アメリカの作物を買っています"
  ]
 },
 {
  "scene": "S30",
  "start": 651.579,
  "end": 657.61,
  "lines": [
   "二〇二三年　日本が輸入したとうもろこしは",
   "約千四百九十万トン"
  ]
 },
 {
  "scene": "S30",
  "start": 658.21,
  "end": 661.853,
  "lines": [
   "その約四十六パーセントが　アメリカ産でした"
  ]
 },
 {
  "scene": "S30",
  "start": 662.453,
  "end": 666.866,
  "lines": [
   "小麦は二〇二四年",
   "アメリカから約二百十一万トン"
  ]
 },
 {
  "scene": "S30",
  "start": 667.466,
  "end": 669.315,
  "lines": [
   "輸入先で一番の量です"
  ]
 },
 {
  "scene": "S30",
  "start": 669.915,
  "end": 673.596,
  "lines": [
   "どの州の畑から来たかまでは　統計には出ません"
  ]
 },
 {
  "scene": "S31",
  "start": 675.396,
  "end": 677.632,
  "lines": [
   "この地下の水は　減っています"
  ]
 },
 {
  "scene": "S31",
  "start": 678.232,
  "end": 683.474,
  "lines": [
   "くみ上げが始まる前の一九五〇年ごろから",
   "二〇一九年までに"
  ]
 },
 {
  "scene": "S31",
  "start": 683.474,
  "end": 687.517,
  "lines": [
   "取り出せる水が",
   "約三千五百億立方メートル減りました"
  ]
 },
 {
  "scene": "S31",
  "start": 688.117,
  "end": 690.905,
  "lines": [
   "琵琶湖の水の　約十三杯分です"
  ]
 },
 {
  "scene": "S31",
  "start": 691.505,
  "end": 697.606,
  "lines": [
   "日本で　一年に田んぼや畑に使う水は",
   "約五百三十億立方メートル"
  ]
 },
 {
  "scene": "S31",
  "start": 698.206,
  "end": 702.986,
  "lines": [
   "減った水は　日本の農業の水の",
   "約七年分にあたります"
  ]
 },
 {
  "scene": "S31",
  "start": 703.586,
  "end": 708.27,
  "lines": [
   "日本の農業の水のうち",
   "地下水は約五パーセントしかありません"
  ]
 },
 {
  "scene": "S32",
  "start": 710.07,
  "end": 712.163,
  "lines": [
   "井戸の水面も　下がりました"
  ]
 },
 {
  "scene": "S32",
  "start": 712.763,
  "end": 715.635,
  "lines": [
   "場所によっては　約八十一メートル"
  ]
 },
 {
  "scene": "S32",
  "start": 716.235,
  "end": 718.62,
  "lines": [
   "二十五階建てのビルほどの高さです"
  ]
 },
 {
  "scene": "S32",
  "start": 719.22,
  "end": 722.793,
  "lines": [
   "層全体の平均では　約五メートル下がりました"
  ]
 },
 {
  "scene": "S33",
  "start": 724.593,
  "end": 727.604,
  "lines": [
   "雨の多い年には　水は少し戻ります"
  ]
 },
 {
  "scene": "S33",
  "start": 728.204,
  "end": 734.125,
  "lines": [
   "二〇一七年から二〇一九年の二年間で",
   "約二十億立方メートル増えました"
  ]
 },
 {
  "scene": "S33",
  "start": 734.725,
  "end": 737.932,
  "lines": [
   "けれど　減った量の百分の一にもなりません"
  ]
 },
 {
  "scene": "S34",
  "start": 739.732,
  "end": 743.027,
  "lines": [
   "雨は　地下の層まで　なかなか届きません"
  ]
 },
 {
  "scene": "S34",
  "start": 743.627,
  "end": 750.747,
  "lines": [
   "南の大平原では　一年に降る雨のうち",
   "地下の水の層まで届くのは　約二パーセントです"
  ]
 },
 {
  "scene": "S34",
  "start": 751.347,
  "end": 753.578,
  "lines": [
   "残りは　地下まで届きません"
  ]
 },
 {
  "scene": "S34",
  "start": 754.178,
  "end": 756.992,
  "lines": [
   "くみ上げる速さに　雨は追いつきません"
  ]
 },
 {
  "scene": "S34",
  "start": 757.592,
  "end": 761.715,
  "lines": [
   "その少ない水も",
   "地面のどこからでも入るわけではありません"
  ]
 },
 {
  "scene": "S34",
  "start": 762.315,
  "end": 767.205,
  "lines": [
   "地下に届く水の九十五パーセントは",
   "面積の五パーセントしかない"
  ]
 },
 {
  "scene": "S34",
  "start": 767.205,
  "end": 769.414,
  "lines": [
   "浅いくぼ地の底から入ります"
  ]
 },
 {
  "scene": "S34",
  "start": 770.014,
  "end": 773.477,
  "lines": [
   "雨の後に水がたまる",
   "プラヤと呼ばれるくぼ地です"
  ]
 },
 {
  "scene": "S35",
  "start": 775.277,
  "end": 778.782,
  "lines": [
   "カンザス州の地質の調査所は",
   "地図をつくりました"
  ]
 },
 {
  "scene": "S35",
  "start": 779.382,
  "end": 784.48,
  "lines": [
   "いまのくみ上げの量を続けたら",
   "あと何年　大量にくみ上げられるか"
  ]
 },
 {
  "scene": "S35",
  "start": 785.08,
  "end": 789.469,
  "lines": [
   "西カンザスには",
   "二十五年に届かない地域がたくさんありました"
  ]
 },
 {
  "scene": "S36",
  "start": 791.269,
  "end": 794.638,
  "lines": [
   "センターピボットは",
   "水を無駄にしにくい機械です"
  ]
 },
 {
  "scene": "S36",
  "start": 795.238,
  "end": 798.338,
  "lines": [
   "それでも　この層は少しずつ干上がっています"
  ]
 },
 {
  "scene": "S37",
  "start": 800.138,
  "end": 801.811,
  "lines": [
   "減らそうとした農家もいます"
  ]
 },
 {
  "scene": "S37",
  "start": 802.411,
  "end": 803.946,
  "lines": [
   "カンザス州のシェリダン郡"
  ]
 },
 {
  "scene": "S37",
  "start": 804.546,
  "end": 810.69,
  "lines": [
   "二〇一三年　農家は自分たちで",
   "くみ上げる水を二割減らす計画をつくりました"
  ]
 },
 {
  "scene": "S37",
  "start": 811.29,
  "end": 815.289,
  "lines": [
   "四年後　くみ上げた水は",
   "三割五分減っていました"
  ]
 },
 {
  "scene": "S37",
  "start": 815.889,
  "end": 822.155,
  "lines": [
   "地下の水面の下がり方は　一年に",
   "約六十センチから　約十五センチになりました"
  ]
 },
 {
  "scene": "S37",
  "start": 822.755,
  "end": 826.431,
  "lines": [
   "作物の取れ高は　目立って減りませんでした"
  ]
 },
 {
  "scene": "S38",
  "start": 828.231,
  "end": 831.574,
  "lines": [
   "同じ丸い畑は　地球の別の場所にもあります"
  ]
 },
 {
  "scene": "S38",
  "start": 832.174,
  "end": 835.805,
  "lines": [
   "サウジアラビアの北西部　ワディ・アッシルハン"
  ]
 },
 {
  "scene": "S38",
  "start": 836.405,
  "end": 840.931,
  "lines": [
   "一九八四年の衛星画像に　畑はありませんでした"
  ]
 },
 {
  "scene": "S38",
  "start": 841.531,
  "end": 847.418,
  "lines": [
   "二〇一一年には　直径約一キロの丸い畑が",
   "一面に並んでいました"
  ]
 },
 {
  "scene": "S39",
  "start": 849.218,
  "end": 852.484,
  "lines": [
   "ここで井戸がくむのは　約二万年前の水です"
  ]
 },
 {
  "scene": "S39",
  "start": 853.084,
  "end": 855.427,
  "lines": [
   "雨は一年に百ミリから二百ミリ"
  ]
 },
 {
  "scene": "S39",
  "start": 856.027,
  "end": 858.608,
  "lines": [
   "くみ上げた分は　ほとんど戻りません"
  ]
 },
 {
  "scene": "S39",
  "start": 859.208,
  "end": 865.157,
  "lines": [
   "丸い畑は　どこでも　足元の水を使って",
   "砂の上に緑をつくっています"
  ]
 },
 {
  "scene": "S40",
  "start": 866.957,
  "end": 873.246,
  "lines": [
   "サウジアラビアの砂漠の農業に使う水は",
   "一九八〇年から二〇〇六年までに"
  ]
 },
 {
  "scene": "S40",
  "start": 873.246,
  "end": 874.86,
  "lines": [
   "約三倍に増えました"
  ]
 },
 {
  "scene": "S40",
  "start": 875.46,
  "end": 881.721,
  "lines": [
   "二〇〇八年　サウジアラビアは",
   "地下の古い水が減ることを理由に　小麦の栽培を"
  ]
 },
 {
  "scene": "S40",
  "start": 881.721,
  "end": 885.013,
  "lines": [
   "二〇一六年までにやめる方針を出します"
  ]
 },
 {
  "scene": "S40",
  "start": 885.613,
  "end": 890.162,
  "lines": [
   "ところが二〇一八年",
   "小麦への支援を　また始めました"
  ]
 },
 {
  "scene": "S40",
  "start": 890.762,
  "end": 894.865,
  "lines": [
   "地下の古い水の量は",
   "二百五十二立方キロメートルから"
  ]
 },
 {
  "scene": "S40",
  "start": 894.865,
  "end": 899.619,
  "lines": [
   "八百七十立方キロメートルと見積もられ",
   "くみ上げが割に合うのは"
  ]
 },
 {
  "scene": "S40",
  "start": 899.619,
  "end": 901.744,
  "lines": [
   "約五十年と見られていました"
  ]
 },
 {
  "scene": "S41",
  "start": 903.544,
  "end": 910.222,
  "lines": [
   "アメリカの真ん中が　丸い畑だらけなのは",
   "雨が足りない土地で　足元の水をくみ上げて"
  ]
 },
 {
  "scene": "S41",
  "start": 910.222,
  "end": 912.375,
  "lines": [
   "回しながらまいているからです"
  ]
 },
 {
  "scene": "S41",
  "start": 912.975,
  "end": 915.97,
  "lines": [
   "西経百度の線の西は　雨が足りない"
  ]
 },
 {
  "scene": "S41",
  "start": 916.57,
  "end": 919.778,
  "lines": [
   "開拓の碁盤の目が　四角い区画をつくった"
  ]
 },
 {
  "scene": "S41",
  "start": 920.378,
  "end": 923.922,
  "lines": [
   "その四角の中に　井戸を中心に回る機械を置いた"
  ]
 },
 {
  "scene": "S41",
  "start": 924.522,
  "end": 929.843,
  "lines": [
   "水は　日本の国土より広い",
   "地下の砂と小石のすき間からくみ上げた"
  ]
 },
 {
  "scene": "S41",
  "start": 930.443,
  "end": 933.097,
  "lines": [
   "それが　空から見える緑の丸です"
  ]
 },
 {
  "scene": "S42",
  "start": 934.897,
  "end": 937.372,
  "lines": [
   "丸い畑は　模様ではありません"
  ]
 },
 {
  "scene": "S42",
  "start": 937.972,
  "end": 940.664,
  "lines": [
   "一つ一つの真ん中に　井戸があります"
  ]
 },
 {
  "scene": "S42",
  "start": 941.264,
  "end": 944.988,
  "lines": [
   "空から見える緑の丸は　地下の水を使った跡です"
  ]
 },
 {
  "scene": "S42",
  "start": 945.588,
  "end": 949.814,
  "lines": [
   "その水は　七十年で　琵琶湖十三杯分減りました"
  ]
 }
]